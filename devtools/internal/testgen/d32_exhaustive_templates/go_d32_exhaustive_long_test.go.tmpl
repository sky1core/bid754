
//go:build cgo && bid754_native && bid754_d32_exhaustive

package bid754

// Decimal32 unary exhaustive differential gate.
//
// Every lane sweeps the full 32-bit input space (bit patterns 0..2^32-1,
// non-canonical encodings included) and requires pinned Intel BID C and the
// Go mechanical port to agree bit+flag exact on every case. The corpus is
// the input space itself, so the generated artifacts carry only the lane
// table, the loop-bound/count constants, and the routing-sentinel rows.
//
// Common-mode tripwires: the lane dispatch below (d32ExhaustiveLegs) is the
// single fan-out shared by the exhaustive sweep and the routing sentinels,
// so an operation or rounding-mode miswire applied identically to both legs
// skews every differential case identically (an agreed-upon wrong answer
// the differential cannot see) while the pinned sentinel rows diverge and
// fail. The per-lane result digests folded over every case are the
// full-space twin of that tripwire: they are hand-pinned in
// devtools/verification_anchors.json and bound to this runner's digest log
// lines by cmd/verifylog (domain d32-exhaustive); no generator can compute
// or update them.

import (
	"encoding/binary"
	"fmt"
	"os"
	"runtime"
	"strconv"
	"strings"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	"github.com/sky1core/bid754/bid754-go/internal/bidgo"
)

const (
	d32ExhaustiveLaneCount         = uint64(@@D32X_LANE_COUNT@@)
	d32ExhaustiveOperationCount    = uint64(@@D32X_OPERATION_COUNT@@)
	d32ExhaustiveCasesPerLane      = uint64(1) << 32
	d32ExhaustiveTotalComparisons  = uint64(@@D32X_TOTAL_COMPARISONS@@)
	d32ExhaustiveSentinelRowCount  = uint64(@@D32X_SENTINEL_COUNT@@)
	d32ExhaustiveChunkBits         = 24
	d32ExhaustiveChunkCount        = d32ExhaustiveCasesPerLane >> d32ExhaustiveChunkBits
	d32ExhaustiveDigestOffset      = uint64(0xcbf29ce484222325)
	d32ExhaustiveDigestPrime       = uint64(0x100000001b3)
	d32ExhaustiveMismatchDetailCap = 64
	d32ExhaustiveProgressChunks    = uint64(32)
)

type d32ExhaustiveOp int

const (
	d32ExhaustiveOpSqrt d32ExhaustiveOp = iota
	d32ExhaustiveOpRoundIntegralExact
	d32ExhaustiveOpRoundIntegralNearestEven
	d32ExhaustiveOpRoundIntegralNearestAway
	d32ExhaustiveOpRoundIntegralZero
	d32ExhaustiveOpRoundIntegralPositive
	d32ExhaustiveOpRoundIntegralNegative
	d32ExhaustiveOpToBid64
	d32ExhaustiveOpToBid128
	d32ExhaustiveOpNextUp
	d32ExhaustiveOpNextDown
	d32ExhaustiveOpLogb
)

// d32ExhaustiveModeTakingOps is the closed set of operations whose lanes
// cover all five native rounding modes; every other operation is a fixed
// single lane carrying nativeMode -1.
var d32ExhaustiveModeTakingOps = []d32ExhaustiveOp{
	d32ExhaustiveOpSqrt,
	d32ExhaustiveOpRoundIntegralExact,
}

func d32ExhaustiveIsModeTakingOp(op d32ExhaustiveOp) bool {
	for _, candidate := range d32ExhaustiveModeTakingOps {
		if op == candidate {
			return true
		}
	}
	return false
}

type d32ExhaustiveLane struct {
	name       string
	opToken    string
	op         d32ExhaustiveOp
	nativeMode int
}

var d32ExhaustiveLanes = []d32ExhaustiveLane{
@@D32X_LANE_ROWS@@}

// d32ExhaustiveLaneNames is the lane-name inventory compared against the
// hand-pinned devtools/verification_anchors.json digest-map key set by
// TestVerificationAnchorsMatchGeneratedArtifacts.
var d32ExhaustiveLaneNames = []string{
@@D32X_LANE_NAME_ROWS@@}

// Routing sentinel rows. Byte-equal to the hand-pinned
// devtools/verification_sentinels.json d32_exhaustive_sentinel_rows entries
// (TestVerificationAnchorsMatchGeneratedArtifacts enforces the equality).
var d32ExhaustiveSentinelRows = []string{
@@D32X_SENTINEL_ROWS@@}

func d32ExhaustiveDigestMix(digest, word uint64) uint64 {
	return (digest ^ word) * d32ExhaustiveDigestPrime
}

// d32ExhaustiveLegs evaluates one case through both legs of one lane. It is
// the single operand/mode/dispatch fan-out shared by the exhaustive sweep
// and the routing sentinels (see the file header). Results are returned as
// (lo, hi) words: 32/64-bit results occupy lo with hi=0; the 128-bit
// promotion returns the little-endian memory-image words.
func d32ExhaustiveLegs(op d32ExhaustiveOp, nativeMode int, x uint32) (nLo, nHi uint64, nFlags uint32, pLo, pHi uint64, pFlags uint32) {
	switch op {
	case d32ExhaustiveOpSqrt:
		nb, nf := d32ExhaustiveNativeSqrt(x, nativeMode)
		pb, pf := bidgo.Bid32Sqrt(x, nativeMode)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	case d32ExhaustiveOpRoundIntegralExact:
		nb, nf := d32ExhaustiveNativeRoundIntegralExact(x, nativeMode)
		pb, pf := bidgo.Bid32RoundIntegralExact(x, nativeMode)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	case d32ExhaustiveOpRoundIntegralNearestEven:
		nb, nf := d32ExhaustiveNativeRoundIntegralNearestEven(x)
		pb, pf := bidgo.Bid32RoundIntegralNearestEven(x)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	case d32ExhaustiveOpRoundIntegralNearestAway:
		nb, nf := d32ExhaustiveNativeRoundIntegralNearestAway(x)
		pb, pf := bidgo.Bid32RoundIntegralNearestAway(x)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	case d32ExhaustiveOpRoundIntegralZero:
		nb, nf := d32ExhaustiveNativeRoundIntegralZero(x)
		pb, pf := bidgo.Bid32RoundIntegralZero(x)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	case d32ExhaustiveOpRoundIntegralPositive:
		nb, nf := d32ExhaustiveNativeRoundIntegralPositive(x)
		pb, pf := bidgo.Bid32RoundIntegralPositive(x)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	case d32ExhaustiveOpRoundIntegralNegative:
		nb, nf := d32ExhaustiveNativeRoundIntegralNegative(x)
		pb, pf := bidgo.Bid32RoundIntegralNegative(x)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	case d32ExhaustiveOpToBid64:
		nb, nf := d32ExhaustiveNativeToBid64(x)
		pb, pf := bidgo.Bid32ToBid64(x)
		return nb, 0, nf, pb, 0, pf
	case d32ExhaustiveOpToBid128:
		nLo, nHi, nf := d32ExhaustiveNativeToBid128(x)
		p128, pf := bidgo.Bid32ToBid128(x)
		image := decimal128BIDFromBidgo(p128)
		return nLo, nHi, nf, binary.LittleEndian.Uint64(image[0:8]), binary.LittleEndian.Uint64(image[8:16]), pf
	case d32ExhaustiveOpNextUp:
		nb, nf := d32ExhaustiveNativeNextUp(x)
		pb, pf := bidgo.Bid32NextUp(x)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	case d32ExhaustiveOpNextDown:
		nb, nf := d32ExhaustiveNativeNextDown(x)
		pb, pf := bidgo.Bid32NextDown(x)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	case d32ExhaustiveOpLogb:
		nb, nf := d32ExhaustiveNativeLogb(x)
		pb, pf := bidgo.Bid32Logb(x)
		return uint64(nb), 0, nf, uint64(pb), 0, pf
	}
	panic(fmt.Sprintf("unknown d32 exhaustive operation %d", op))
}

// d32ExhaustiveResultBits reports the result width of one lane operation for
// diagnostic and sentinel-leg formatting.
func d32ExhaustiveResultBits(op d32ExhaustiveOp) int {
	switch op {
	case d32ExhaustiveOpToBid64:
		return 64
	case d32ExhaustiveOpToBid128:
		return 128
	default:
		return 32
	}
}

func d32ExhaustiveFormatResult(op d32ExhaustiveOp, lo, hi uint64, flags uint32) string {
	switch d32ExhaustiveResultBits(op) {
	case 64:
		return fmt.Sprintf("%016x/%08x", lo, flags)
	case 128:
		return fmt.Sprintf("%016x:%016x/%08x", hi, lo, flags)
	default:
		return fmt.Sprintf("%08x/%08x", uint32(lo), flags)
	}
}

// d32ExhaustiveClassify buckets one input bit pattern for mismatch
// reporting (diagnostic only; no gate decision depends on it).
func d32ExhaustiveClassify(x uint32) string {
	masked := x & 0x7fffffff
	switch {
	case masked&0x7e000000 == 0x7e000000:
		return "snan"
	case masked&0x7c000000 == 0x7c000000:
		return "qnan"
	case masked&0x78000000 == 0x78000000:
		return "infinity"
	}
	var coefficient uint32
	if masked&0x60000000 == 0x60000000 {
		coefficient = 0x800000 | (masked & 0x1fffff)
	} else {
		coefficient = masked & 0x7fffff
	}
	switch {
	case coefficient > 9999999:
		return "noncanonical_coefficient"
	case coefficient == 0:
		return "zero"
	default:
		return "finite"
	}
}

// d32ExhaustiveLaneRecorder collects every mismatch of one lane: the full
// per-class counts always, plus the first d32ExhaustiveMismatchDetailCap
// rows in full detail.
type d32ExhaustiveLaneRecorder struct {
	mu      sync.Mutex
	total   uint64
	byClass map[string]uint64
	detail  []string
}

func (r *d32ExhaustiveLaneRecorder) record(op d32ExhaustiveOp, x uint32, nLo, nHi uint64, nFlags uint32, pLo, pHi uint64, pFlags uint32) {
	class := d32ExhaustiveClassify(x)
	r.mu.Lock()
	defer r.mu.Unlock()
	if r.byClass == nil {
		r.byClass = map[string]uint64{}
	}
	r.total++
	r.byClass[class]++
	if len(r.detail) < d32ExhaustiveMismatchDetailCap {
		r.detail = append(r.detail, fmt.Sprintf("x=%08x class=%s C=%s port=%s",
			x, class,
			d32ExhaustiveFormatResult(op, nLo, nHi, nFlags),
			d32ExhaustiveFormatResult(op, pLo, pHi, pFlags)))
	}
}

func (r *d32ExhaustiveLaneRecorder) report(t *testing.T, lane d32ExhaustiveLane) {
	t.Helper()
	if r.total == 0 {
		return
	}
	classes := make([]string, 0, len(r.byClass))
	for class := range r.byClass {
		classes = append(classes, class)
	}
	for i := 0; i < len(classes); i++ {
		for j := i + 1; j < len(classes); j++ {
			if classes[j] < classes[i] {
				classes[i], classes[j] = classes[j], classes[i]
			}
		}
	}
	summary := make([]string, 0, len(classes))
	for _, class := range classes {
		summary = append(summary, fmt.Sprintf("%s=%d", class, r.byClass[class]))
	}
	t.Errorf("decimal32 exhaustive lane %s: %d mismatching cases (by input class: %s); first %d in full detail:\n%s",
		lane.name, r.total, strings.Join(summary, " "), len(r.detail), strings.Join(r.detail, "\n"))
}

type d32ExhaustiveShard struct {
	count uint64
	index uint64
}

// d32ExhaustiveLoadShard reads the optional chunk-level shard split. A
// sharded run is a development aid: it suppresses the per-lane digests
// (they are defined over the full ordered space only) and cannot produce
// the full-count evidence lines cmd/verifylog requires.
func d32ExhaustiveLoadShard(t *testing.T) d32ExhaustiveShard {
	t.Helper()
	countText := os.Getenv("BID754_D32_EXHAUSTIVE_SHARD_COUNT")
	indexText := os.Getenv("BID754_D32_EXHAUSTIVE_SHARD_INDEX")
	if countText == "" && indexText == "" {
		return d32ExhaustiveShard{count: 1}
	}
	if countText == "" || indexText == "" {
		t.Fatal("BID754_D32_EXHAUSTIVE_SHARD_COUNT and BID754_D32_EXHAUSTIVE_SHARD_INDEX must be set together")
	}
	count, err := strconv.ParseUint(countText, 10, 64)
	if err != nil || count == 0 {
		t.Fatalf("invalid BID754_D32_EXHAUSTIVE_SHARD_COUNT %q", countText)
	}
	index, err := strconv.ParseUint(indexText, 10, 64)
	if err != nil || index >= count {
		t.Fatalf("invalid BID754_D32_EXHAUSTIVE_SHARD_INDEX %q for shard count %d", indexText, count)
	}
	return d32ExhaustiveShard{count: count, index: index}
}

func (s d32ExhaustiveShard) owns(chunk uint64) bool {
	return chunk%s.count == s.index
}

func (s d32ExhaustiveShard) ownedChunks(total uint64) uint64 {
	if total <= s.index {
		return 0
	}
	return 1 + (total-1-s.index)/s.count
}

// d32ExhaustiveRunChunk sweeps one contiguous chunk of one lane in
// ascending input order and returns the chunk's ordered result digest.
func d32ExhaustiveRunChunk(lane d32ExhaustiveLane, chunk uint64, recorder *d32ExhaustiveLaneRecorder) uint64 {
	start := chunk << d32ExhaustiveChunkBits
	end := start + (uint64(1) << d32ExhaustiveChunkBits)
	digest := d32ExhaustiveDigestOffset
	for x := start; x < end; x++ {
		nLo, nHi, nFlags, pLo, pHi, pFlags := d32ExhaustiveLegs(lane.op, lane.nativeMode, uint32(x))
		if nLo != pLo || nHi != pHi || nFlags != pFlags {
			recorder.record(lane.op, uint32(x), nLo, nHi, nFlags, pLo, pHi, pFlags)
		}
		digest = d32ExhaustiveDigestMix(digest, nLo)
		digest = d32ExhaustiveDigestMix(digest, nHi)
		digest = d32ExhaustiveDigestMix(digest, uint64(nFlags))
		digest = d32ExhaustiveDigestMix(digest, pLo)
		digest = d32ExhaustiveDigestMix(digest, pHi)
		digest = d32ExhaustiveDigestMix(digest, uint64(pFlags))
	}
	return digest
}

// d32ExhaustiveRunLane executes one lane's owned chunks across worker
// goroutines. Chunk digests are folded in ascending chunk order after every
// worker finishes, so the lane digest is deterministic regardless of
// scheduling; it is only defined (and only logged) on unsharded runs.
func d32ExhaustiveRunLane(t *testing.T, lane d32ExhaustiveLane, shard d32ExhaustiveShard) (executed uint64, digest uint64, digestComplete bool, recorder *d32ExhaustiveLaneRecorder) {
	t.Helper()
	recorder = &d32ExhaustiveLaneRecorder{}
	chunkDigests := make([]uint64, d32ExhaustiveChunkCount)
	ownedTotal := shard.ownedChunks(d32ExhaustiveChunkCount)
	workers := runtime.GOMAXPROCS(0)
	if workers < 1 {
		workers = 1
	}
	var next atomic.Uint64
	var completed atomic.Uint64
	start := time.Now()
	var wg sync.WaitGroup
	for w := 0; w < workers; w++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for {
				chunk := next.Add(1) - 1
				if chunk >= d32ExhaustiveChunkCount {
					return
				}
				if !shard.owns(chunk) {
					continue
				}
				chunkDigests[chunk] = d32ExhaustiveRunChunk(lane, chunk, recorder)
				done := completed.Add(1)
				if done%d32ExhaustiveProgressChunks == 0 && done != ownedTotal {
					t.Logf("decimal32 exhaustive lane %s progress: %d/%d chunks elapsed=%s",
						lane.name, done, ownedTotal, time.Since(start).Round(time.Second))
				}
			}
		}()
	}
	wg.Wait()
	executed = ownedTotal << d32ExhaustiveChunkBits
	digestComplete = shard.count == 1
	if digestComplete {
		digest = d32ExhaustiveDigestOffset
		for _, chunkDigest := range chunkDigests {
			digest = d32ExhaustiveDigestMix(digest, chunkDigest)
		}
		digest = d32ExhaustiveDigestMix(digest, d32ExhaustiveCasesPerLane)
	}
	t.Logf("decimal32 exhaustive lane %s finished: %d/%d chunks elapsed=%s",
		lane.name, ownedTotal, ownedTotal, time.Since(start).Round(time.Second))
	return executed, digest, digestComplete, recorder
}

// d32ExhaustiveParseSentinelRow parses one pinned row:
//
//	d32 <op> x=<8-hex> [m=<mode>] -> <expected leg text>
//
// and resolves it to a lane through the same lane table the exhaustive
// sweep dispatches from.
func d32ExhaustiveParseSentinelRow(t *testing.T, rowIndex int, row string) (d32ExhaustiveLane, uint32, string) {
	t.Helper()
	fail := func(reason string) {
		t.Fatalf("sentinel row %d is malformed (%s): %q", rowIndex, reason, row)
	}
	head, want, found := strings.Cut(row, " -> ")
	if !found {
		fail("no -> separator")
	}
	fields := strings.Fields(head)
	if len(fields) < 3 || fields[0] != "d32" {
		fail("head is not `d32 <op> x=... [m=...]`")
	}
	opToken := fields[1]
	if !strings.HasPrefix(fields[2], "x=") || len(fields[2]) != 2+8 {
		fail("operand is not x=<8-hex>")
	}
	parsed, err := strconv.ParseUint(fields[2][2:], 16, 32)
	if err != nil {
		fail("operand is not valid hex")
	}
	mode := -1
	switch len(fields) {
	case 3:
	case 4:
		if !strings.HasPrefix(fields[3], "m=") {
			fail("fourth token is not m=<mode>")
		}
		parsedMode, err := strconv.Atoi(fields[3][2:])
		if err != nil || parsedMode < 0 || parsedMode > 4 {
			fail("mode is not a native rounding mode 0..4")
		}
		mode = parsedMode
	default:
		fail("unexpected token count")
	}
	for _, lane := range d32ExhaustiveLanes {
		if lane.opToken == opToken && lane.nativeMode == mode {
			return lane, uint32(parsed), want
		}
	}
	fail("no lane matches the (op, mode) pair")
	return d32ExhaustiveLane{}, 0, ""
}

// TestGeneratedD32ExhaustiveLaneContract closes the generated lane and
// sentinel inventories against the generated count constants before the
// long sweep spends any time.
func TestGeneratedD32ExhaustiveLaneContract(t *testing.T) {
	requireNative(t)
	if uint64(len(d32ExhaustiveLanes)) != d32ExhaustiveLaneCount {
		t.Fatalf("lane table carries %d lanes, generated constant says %d", len(d32ExhaustiveLanes), d32ExhaustiveLaneCount)
	}
	if uint64(len(d32ExhaustiveLaneNames)) != d32ExhaustiveLaneCount {
		t.Fatalf("lane name inventory carries %d names, generated constant says %d", len(d32ExhaustiveLaneNames), d32ExhaustiveLaneCount)
	}
	names := map[string]bool{}
	ops := map[d32ExhaustiveOp]bool{}
	modesByOp := map[d32ExhaustiveOp]map[int]bool{}
	for i, lane := range d32ExhaustiveLanes {
		if lane.name != d32ExhaustiveLaneNames[i] {
			t.Fatalf("lane %d name %q diverges from lane-name inventory entry %q", i, lane.name, d32ExhaustiveLaneNames[i])
		}
		if names[lane.name] {
			t.Fatalf("duplicate lane name %q", lane.name)
		}
		names[lane.name] = true
		ops[lane.op] = true
		if modesByOp[lane.op] == nil {
			modesByOp[lane.op] = map[int]bool{}
		}
		if modesByOp[lane.op][lane.nativeMode] {
			t.Fatalf("duplicate (op, mode) lane %q", lane.name)
		}
		modesByOp[lane.op][lane.nativeMode] = true
		if d32ExhaustiveIsModeTakingOp(lane.op) {
			if lane.nativeMode < 0 || lane.nativeMode > 4 {
				t.Fatalf("mode-taking lane %q carries native mode %d outside 0..4", lane.name, lane.nativeMode)
			}
		} else if lane.nativeMode != -1 {
			t.Fatalf("fixed-attribute lane %q carries native mode %d, want -1", lane.name, lane.nativeMode)
		}
	}
	if uint64(len(ops)) != d32ExhaustiveOperationCount {
		t.Fatalf("lane table exercises %d distinct operations, generated constant says %d", len(ops), d32ExhaustiveOperationCount)
	}
	for _, op := range d32ExhaustiveModeTakingOps {
		if len(modesByOp[op]) != 5 {
			t.Fatalf("mode-taking operation %d covers %d modes, want all 5", op, len(modesByOp[op]))
		}
	}
	if d32ExhaustiveChunkCount<<d32ExhaustiveChunkBits != d32ExhaustiveCasesPerLane {
		t.Fatalf("chunk split %d<<%d does not cover the per-lane space %d", d32ExhaustiveChunkCount, d32ExhaustiveChunkBits, d32ExhaustiveCasesPerLane)
	}
	if d32ExhaustiveLaneCount*d32ExhaustiveCasesPerLane != d32ExhaustiveTotalComparisons {
		t.Fatalf("lane count %d x per-lane space %d does not equal the generated total %d", d32ExhaustiveLaneCount, d32ExhaustiveCasesPerLane, d32ExhaustiveTotalComparisons)
	}
	if uint64(len(d32ExhaustiveSentinelRows)) != d32ExhaustiveSentinelRowCount {
		t.Fatalf("sentinel row literal count %d diverges from the generated constant %d", len(d32ExhaustiveSentinelRows), d32ExhaustiveSentinelRowCount)
	}
	coveredLanes := map[string]bool{}
	for rowIndex, row := range d32ExhaustiveSentinelRows {
		lane, _, _ := d32ExhaustiveParseSentinelRow(t, rowIndex, row)
		coveredLanes[lane.name] = true
	}
	for _, lane := range d32ExhaustiveLanes {
		if !coveredLanes[lane.name] {
			t.Fatalf("lane %q is not covered by any routing-sentinel row", lane.name)
		}
	}
	t.Logf("decimal32 exhaustive unary lane contract: lanes=%d operations=%d cases_per_lane=%d total=%d",
		d32ExhaustiveLaneCount, d32ExhaustiveOperationCount, d32ExhaustiveCasesPerLane, d32ExhaustiveTotalComparisons)
}

// TestGeneratedD32ExhaustiveRoutingSentinels replays the pinned known-answer
// rows through the same lane dispatch the exhaustive sweep uses and
// requires pinned == Intel C == Go port on every row.
func TestGeneratedD32ExhaustiveRoutingSentinels(t *testing.T) {
	requireNative(t)
	executed := uint64(0)
	for rowIndex, row := range d32ExhaustiveSentinelRows {
		lane, x, want := d32ExhaustiveParseSentinelRow(t, rowIndex, row)
		nLo, nHi, nFlags, pLo, pHi, pFlags := d32ExhaustiveLegs(lane.op, lane.nativeMode, x)
		native := d32ExhaustiveFormatResult(lane.op, nLo, nHi, nFlags)
		port := d32ExhaustiveFormatResult(lane.op, pLo, pHi, pFlags)
		if native != want {
			t.Fatalf("sentinel row %d (%s): Intel C leg %q diverges from pinned %q", rowIndex, row, native, want)
		}
		if port != want {
			t.Fatalf("sentinel row %d (%s): Go port leg %q diverges from pinned %q", rowIndex, row, port, want)
		}
		executed++
	}
	if executed != d32ExhaustiveSentinelRowCount {
		t.Fatalf("executed %d sentinel rows, want %d", executed, d32ExhaustiveSentinelRowCount)
	}
	t.Logf("d32 exhaustive routing sentinels: %d/%d", executed, executed)
}

// TestGeneratedD32ExhaustiveUnaryDifferential is the long gate: every lane,
// every 32-bit input, bit+flag exact.
func TestGeneratedD32ExhaustiveUnaryDifferential(t *testing.T) {
	requireNative(t)
	if strconv.IntSize != 64 {
		t.Fatalf("d32 exhaustive native oracle requires the guaranteed LP64 platform contract; int size=%d", strconv.IntSize)
	}
	shard := d32ExhaustiveLoadShard(t)
	totalExecuted := uint64(0)
	for _, lane := range d32ExhaustiveLanes {
		executed, digest, digestComplete, recorder := d32ExhaustiveRunLane(t, lane, shard)
		totalExecuted += executed
		recorder.report(t, lane)
		if digestComplete {
			t.Logf("decimal32 exhaustive lane %s: exact comparisons %d/%d digest=%d",
				lane.name, executed, d32ExhaustiveCasesPerLane, digest)
		} else {
			t.Logf("decimal32 exhaustive lane %s: exact comparisons %d/%d (sharded run; lane digest suppressed)",
				lane.name, executed, d32ExhaustiveCasesPerLane)
		}
	}
	if shard.count == 1 && totalExecuted != d32ExhaustiveTotalComparisons {
		t.Fatalf("executed %d comparisons, want %d", totalExecuted, d32ExhaustiveTotalComparisons)
	}
	t.Logf("decimal32 exhaustive unary total comparisons: %d/%d", totalExecuted, d32ExhaustiveTotalComparisons)
}
