package testspec

import (
	"encoding/json"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestLoadGeneratedRejectsUnknownFieldsAndTrailingJSON(t *testing.T) {
	const (
		indexRel    = "spec_index.json"
		readtestRel = "readtest/strict_readtest.json"
		ffiRel      = "ffi/strict_ffi.json"
	)

	fixtures := strictJSONConsumerFixtures(t, readtestRel, ffiRel)

	t.Run("valid fixtures load", func(t *testing.T) {
		root := writeStrictJSONConsumerFixtures(t, fixtures, "", nil)
		if _, err := LoadGenerated(filepath.Join(root, indexRel)); err != nil {
			t.Fatalf("LoadGenerated valid fixtures: %v", err)
		}
	})

	for _, tc := range []struct {
		name        string
		target      string
		mutate      func([]byte) []byte
		wantContext string
		wantReason  string
	}{
		{name: "index unknown field", target: indexRel, mutate: addStrictJSONUnknownField, wantContext: "parse generated spec index", wantReason: "unknown field"},
		{name: "index trailing value", target: indexRel, mutate: appendStrictJSONTrailingValue, wantContext: "parse generated spec index", wantReason: "trailing JSON"},
		{name: "readtest shard unknown field", target: readtestRel, mutate: addStrictJSONUnknownField, wantContext: "parse readtest shard", wantReason: "unknown field"},
		{name: "readtest shard trailing value", target: readtestRel, mutate: appendStrictJSONTrailingValue, wantContext: "parse readtest shard", wantReason: "trailing JSON"},
		{name: "ffi shard unknown field", target: ffiRel, mutate: addStrictJSONUnknownField, wantContext: "parse ffi shard", wantReason: "unknown field"},
		{name: "ffi shard trailing value", target: ffiRel, mutate: appendStrictJSONTrailingValue, wantContext: "parse ffi shard", wantReason: "trailing JSON"},
	} {
		t.Run(tc.name, func(t *testing.T) {
			root := writeStrictJSONConsumerFixtures(t, fixtures, tc.target, tc.mutate)
			_, err := LoadGenerated(filepath.Join(root, indexRel))
			if err == nil {
				t.Fatal("LoadGenerated accepted invalid JSON")
			}
			if !strings.Contains(err.Error(), tc.wantContext) || !strings.Contains(err.Error(), tc.wantReason) {
				t.Fatalf("LoadGenerated error = %q, want context %q and reason %q", err, tc.wantContext, tc.wantReason)
			}
		})
	}
}

func strictJSONConsumerFixtures(t *testing.T, readtestRel, ffiRel string) map[string][]byte {
	t.Helper()
	values := map[string]any{
		"spec_index.json": SpecIndex{
			DectestSuites:      []GeneratedDectestSuite{},
			FuzzCases:          []GeneratedFuzzCase{},
			ReadtestShardFiles: []string{readtestRel},
			FFIShardFiles:      []string{ffiRel},
		},
		readtestRel: ReadtestShard{
			ReadtestShardHeader: ReadtestShardHeader{
				Suite:    "strict_readtest",
				Format:   "decimal64",
				Header:   "readtest.h",
				Source:   "readtest.in",
				Function: "bid64_add",
				Kind:     "binary_op",
			},
			Cases: []ReadtestShardCase{{
				ID:       "strict_readtest_001",
				Line:     1,
				Operands: []string{"1", "2"},
				Expected: "3",
				Status:   "00",
			}},
		},
		ffiRel: FFIShard{
			FFIShardHeader: FFIShardHeader{
				Suite:       "strict_ffi",
				Format:      "decimal64",
				ResultBits:  64,
				OperandBits: []int{128},
				Operation:   "sqrt",
				Function:    "bid64q_sqrt",
				LinkName:    "__bid64q_sqrt",
				Declaration: "BID_UINT64 bid64q_sqrt(...) ",
				Source:      "generated/json/intel_dfp_symbols.json",
			},
			Cases: []FFIShardCase{{
				ID:       "strict_ffi_001",
				Operands: []string{"30400000000000000000000000000002"},
			}},
		},
	}

	fixtures := make(map[string][]byte, len(values))
	for relative, value := range values {
		data, err := json.Marshal(value)
		if err != nil {
			t.Fatalf("marshal fixture %s: %v", relative, err)
		}
		fixtures[relative] = append(data, '\n')
	}
	return fixtures
}

func writeStrictJSONConsumerFixtures(t *testing.T, fixtures map[string][]byte, mutateTarget string, mutate func([]byte) []byte) string {
	t.Helper()
	root := t.TempDir()
	for relative, data := range fixtures {
		if relative == mutateTarget {
			data = mutate(data)
		}
		fullPath := filepath.Join(root, filepath.FromSlash(relative))
		if err := os.MkdirAll(filepath.Dir(fullPath), 0o755); err != nil {
			t.Fatalf("mkdir fixture directory for %s: %v", relative, err)
		}
		if err := os.WriteFile(fullPath, data, 0o600); err != nil {
			t.Fatalf("write fixture %s: %v", relative, err)
		}
	}
	return root
}

func addStrictJSONUnknownField(data []byte) []byte {
	return []byte(strings.Replace(string(data), "{", "{\"unexpected_field\":true,", 1))
}

func appendStrictJSONTrailingValue(data []byte) []byte {
	return append(append([]byte(nil), data...), []byte("{}\n")...)
}
