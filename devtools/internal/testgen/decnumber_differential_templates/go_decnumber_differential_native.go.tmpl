import "C"

import (
	"unsafe"
)

// decnumberDiffRawDnResult carries one decNumber-leg evaluation in
// primitive form. This non-test file must not reference the shared
// comparison-triple types (they live in a tag-free _test file so the
// portable build and the hand-written strength anchor can exercise them
// without cgo); the tagged runner test file converts this raw form into the
// comparison triple. rc values 0-4 come from the C shim.
//
// kind: 0 finite (digits/exponent/bcd valid), 1 infinity, 2 quiet NaN,
// 3 signaling NaN.
type decnumberDiffRawDnResult struct {
	kind        int32
	sign        bool
	exponent    int32
	digits      int32
	bcd         [40]uint8
	rawStatus   uint32
	parseStatus uint32
	rc          int
}

// decnumberDiffRunDnRaw evaluates one case on the pinned decNumber leg.
// opCode: 0 add, 1 sub, 2 mul, 3 div, 4 fma, 5 quantize, 6 sqrt (the
// generated runner's fixed operation numbering); arity selects how many
// operand strings are passed.
func decnumberDiffRunDnRaw(opCode, widthBits, intelRounding int, s1, s2, s3 string, arity int) decnumberDiffRawDnResult {
	c1 := C.CString(s1)
	defer C.free(unsafe.Pointer(c1))
	var c2, c3 *C.char
	if arity >= 2 {
		c2 = C.CString(s2)
		defer C.free(unsafe.Pointer(c2))
	}
	if arity >= 3 {
		c3 = C.CString(s3)
		defer C.free(unsafe.Pointer(c3))
	}
	var kind, sign, exponent, digits C.int32_t
	var status, parseStatus C.uint32_t
	var bcd [40]C.uint8_t
	rc := C.bid754_decnumber_diff_op(C.int(opCode), C.int(widthBits), C.int(intelRounding),
		c1, c2, c3, &kind, &sign, &exponent, &digits, &bcd[0], &status, &parseStatus)

	result := decnumberDiffRawDnResult{
		kind:        int32(kind),
		sign:        sign != 0,
		exponent:    int32(exponent),
		digits:      int32(digits),
		rawStatus:   uint32(status),
		parseStatus: uint32(parseStatus),
		rc:          int(rc),
	}
	for i := range result.bcd {
		result.bcd[i] = uint8(bcd[i])
	}
	return result
}

// decnumberDiffCStatusBits returns the compiled decNumber header's status
// bit values in the fixed order the shared pinned constants declare, so the
// corpus contract test cross-checks the hardcoded projection table against
// the actually linked decNumber build.
func decnumberDiffCStatusBits() [13]uint32 {
	return [13]uint32{
		uint32(C.DEC_Conversion_syntax),
		uint32(C.DEC_Division_by_zero),
		uint32(C.DEC_Division_impossible),
		uint32(C.DEC_Division_undefined),
		uint32(C.DEC_Insufficient_storage),
		uint32(C.DEC_Inexact),
		uint32(C.DEC_Invalid_context),
		uint32(C.DEC_Invalid_operation),
		uint32(C.DEC_Overflow),
		uint32(C.DEC_Clamped),
		uint32(C.DEC_Rounded),
		uint32(C.DEC_Subnormal),
		uint32(C.DEC_Underflow),
	}
}

// decnumberDiffCVersion reports the linked decNumber version string for the
// pinned-oracle identity check.
func decnumberDiffCVersion() string {
	return C.GoString(C.bid754_decnumber_diff_version())
}
