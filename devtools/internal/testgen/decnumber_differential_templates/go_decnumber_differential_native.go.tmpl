	parseCtx.digits = DECNUMDIGITS;
	parseCtx.emax = 999999999;
	parseCtx.emin = -999999999;
	parseCtx.traps = 0;
	parseCtx.status = 0;

	decContextDefault(&ctx, DEC_INIT_BASE);
	if (width == 32) { ctx.digits = 7; ctx.emax = 96; ctx.emin = -95; }
	else if (width == 64) { ctx.digits = 16; ctx.emax = 384; ctx.emin = -383; }
	else if (width == 128) { ctx.digits = 34; ctx.emax = 6144; ctx.emin = -6143; }
	else return 1;
	ctx.round = rounding;
	ctx.clamp = 1;
	ctx.traps = 0;
	ctx.status = 0;

	decNumberFromString(&a, s1, &parseCtx);
	if (parseCtx.status != 0) { *parse_status = (uint32_t)parseCtx.status; return 2; }
	if (s2 != NULL) {
		decNumberFromString(&b, s2, &parseCtx);
		if (parseCtx.status != 0) { *parse_status = (uint32_t)parseCtx.status; return 2; }
	}
	if (s3 != NULL) {
		decNumberFromString(&c, s3, &parseCtx);
		if (parseCtx.status != 0) { *parse_status = (uint32_t)parseCtx.status; return 2; }
	}

	switch (op) {
	case 0: decNumberAdd(&r, &a, &b, &ctx); break;
	case 1: decNumberSubtract(&r, &a, &b, &ctx); break;
	case 2: decNumberMultiply(&r, &a, &b, &ctx); break;
	case 3: decNumberDivide(&r, &a, &b, &ctx); break;
	case 4: decNumberFMA(&r, &a, &b, &c, &ctx); break;
	case 5: decNumberQuantize(&r, &a, &b, &ctx); break;
	case 6: decNumberSquareRoot(&r, &a, &ctx); break;
	default: return 3;
	}

	*status = (uint32_t)ctx.status;
	*sign = decNumberIsNegative(&r) ? 1 : 0;
	if (decNumberIsInfinite(&r)) { *kind = 1; *exponent = 0; *digits = 0; return 0; }
	if (decNumberIsSNaN(&r)) { *kind = 3; *exponent = 0; *digits = 0; return 0; }
	if (decNumberIsNaN(&r)) { *kind = 2; *exponent = 0; *digits = 0; return 0; }
	*kind = 0;
	*exponent = r.exponent;
	*digits = r.digits;
	decNumberGetBCD(&r, bcd);
	return 0;
}

static const char* bid754_decnumber_diff_version(void) {
	return decNumberVersion();
}
