
//go:build cgo && bid754_native && bid754_decnumber_diff

package bid754

// decNumber third-oracle differential gate: pinned IBM decNumber 3.68 leg.
//
// This non-test cgo shim exists only for the decnumber_differential gate
// (test files cannot carry cgo preambles). It evaluates one operation in a
// width-fixed GDA context and extracts the result structurally
// (decNumberGetBCD + exponent + class predicates) so no decNumber string
// formatting semantics enter the comparison. Contexts are set explicitly —
// digits/emax/emin per width, clamp=1, traps=0 — never inherited from
// DEC_INIT_* defaults. Operand parsing uses a wide exact context
// (digits=DECNUMDIGITS, huge exponent range) so every generated operand
// parses exactly; a nonzero parse status is a hard gate failure, never a
// skip. No correction or heuristic from the decTest pipeline is carried
// here (design ledger L14/U1: the decimal64FromNumber overflow workaround
// is a re-encoding-path concern that must not be transplanted).

/*
#cgo CFLAGS: -DDECNUMDIGITS=34
#cgo LDFLAGS: -ldecnumber -lm

#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <decContext.h>
#include <decNumber.h>

// Intel raw rounding numbers (0..4) -> decNumber rounding enum (design
// ledger L17). GDA 05up/half_down stay unused. Returns -1 for an unmapped
// mode so the Go side hard-fails instead of defaulting.
static int bid754_decnumber_diff_rounding(int intelRounding, enum rounding* out) {
	switch (intelRounding) {
	case 0: *out = DEC_ROUND_HALF_EVEN; return 0;
	case 1: *out = DEC_ROUND_FLOOR; return 0;
	case 2: *out = DEC_ROUND_CEILING; return 0;
	case 3: *out = DEC_ROUND_DOWN; return 0;
	case 4: *out = DEC_ROUND_HALF_UP; return 0;
	default: return -1;
	}
}

// op: 0 add, 1 sub, 2 mul, 3 div, 4 fma, 5 quantize, 6 sqrt.
// Returns 0 ok; 1 bad width; 2 operand parse failure (parse_status set);
// 3 bad op; 4 bad rounding mode.
static int bid754_decnumber_diff_op(int op, int width, int rnd,
		const char* s1, const char* s2, const char* s3,
		int32_t* kind, int32_t* sign, int32_t* exponent, int32_t* digits,
		uint8_t* bcd, uint32_t* status, uint32_t* parse_status) {
	decContext parseCtx, ctx;
	decNumber a, b, c, r;
	enum rounding rounding;
	*parse_status = 0;
	*status = 0;

	if (bid754_decnumber_diff_rounding(rnd, &rounding) != 0) {
		return 4;
	}

