// TestGeneratedDecnumberDifferentialCorpusContract closes the corpus
// identity: literal array counts, canonical-only materialization, the
// anchored structured stream hash, the replayed structured exclusion
// counts, the pinned decNumber status-bit table against the linked build,
// and the pinned oracle version.
func TestGeneratedDecnumberDifferentialCorpusContract(t *testing.T) {
	version := decnumberDiffCVersion()
	if !strings.Contains(version, "3.68") {
		t.Fatalf("linked decNumber version %q is not the pinned 3.68 oracle", version)
	}
	cBits := decnumberDiffCStatusBits()
	pinnedBits := [...]uint32{
		decnumberDiffDnConversionSyntax,
		decnumberDiffDnDivisionByZero,
		decnumberDiffDnDivisionImpossible,
		decnumberDiffDnDivisionUndefined,
		decnumberDiffDnInsufficientStore,
		decnumberDiffDnInexact,
		decnumberDiffDnInvalidContext,
		decnumberDiffDnInvalidOperation,
		decnumberDiffDnOverflow,
		decnumberDiffDnClamped,
		decnumberDiffDnRounded,
		decnumberDiffDnSubnormal,
		decnumberDiffDnUnderflow,
	}
	for i := range pinnedBits {
		if cBits[i] != pinnedBits[i] {
			t.Fatalf("pinned decNumber status bit %d (%08x) diverges from the linked decContext.h (%08x); the fixed projection table would be skewed", i, pinnedBits[i], cBits[i])
		}
	}
	if got := uint64(len(decnumberDiffSentinelRows)); got != decnumberDiffSentinelRowCount {
		t.Fatalf("sentinel row literal count %d diverges from the generated constant %d", got, decnumberDiffSentinelRowCount)
	}
	for _, expect := range decnumberDiffWidthExpectations {
		corpus := decnumberDiffMaterializeCorpus(t, expect.width)
		if got := uint64(len(corpus.boundary)); got != expect.boundaryCount {
			t.Fatalf("decimal%d boundary corpus count %d diverges from anchored constant %d", expect.width.bits, got, expect.boundaryCount)
		}
		if got := uint64(len(corpus.probes)); got != expect.probeCount {
			t.Fatalf("decimal%d probe corpus count %d diverges from anchored constant %d", expect.width.bits, got, expect.probeCount)
		}
		if got := uint64(len(corpus.exactProduct)); got != expect.exactProductCount {
			t.Fatalf("decimal%d exact-product corpus count %d diverges from anchored constant %d", expect.width.bits, got, expect.exactProductCount)
		}
		if got := uint64(len(corpus.exactProductZ)); got != expect.exactProductZCount {
			t.Fatalf("decimal%d exact-product addend count %d diverges from anchored constant %d", expect.width.bits, got, expect.exactProductZCount)
		}
		if got := corpus.structuredStreamHash(); got != expect.structuredStreamHash {
			t.Fatalf("decimal%d structured stream hash %d diverges from anchored constant %d", expect.width.bits, got, expect.structuredStreamHash)
		}
		var pairVisits, tripleVisits, excluded uint64
		corpus.visitStructuredPairs(func(x, y decnumberDiffOperand) { pairVisits++ })
		corpus.visitStructuredTriples(func(x, y, z decnumberDiffOperand) {
			tripleVisits++
			if decnumberDiffFmaExcluded(x.triple, y.triple, z.triple) {
				excluded++
			}
		})
		if excluded != expect.structuredFmaExcluded {
			t.Fatalf("decimal%d structured fma exclusion replay %d diverges from anchored constant %d", expect.width.bits, excluded, expect.structuredFmaExcluded)
		}
		wantStructured := pairVisits*uint64(len(decnumberDiffRoundedOpsTable))*uint64(len(decnumberDiffModes)) +
			(tripleVisits-excluded)*uint64(len(decnumberDiffModes)) +
			uint64(len(corpus.boundary))
		if wantStructured != expect.structuredComparisons {
			t.Fatalf("decimal%d structured comparison formula %d diverges from anchored constant %d", expect.width.bits, wantStructured, expect.structuredComparisons)
		}
		if expect.structuredComparisons+expect.randomComparisons != expect.totalComparisons {
			t.Fatalf("decimal%d total comparison constant is inconsistent: %d+%d != %d",
				expect.width.bits, expect.structuredComparisons, expect.randomComparisons, expect.totalComparisons)
		}
		t.Logf("decimal%d decnumber differential corpus contract: boundary=%d probes=%d exact_product=%d structured_stream_hash=%d",
			expect.width.bits, len(corpus.boundary), len(corpus.probes), len(corpus.exactProduct), corpus.structuredStreamHash())
	}
}

// TestGeneratedDecnumberDifferentialRoutingSentinels replays the pinned
// known-answer rows through the same leg fan-out as the differentials, so
// an operand slot swap, rounding-mode miswire, or width/context mislabel
// that skews every differential leg identically still diverges from the
// hand-audited pins.
func TestGeneratedDecnumberDifferentialRoutingSentinels(t *testing.T) {
	executed := 0
	for rowIndex, row := range decnumberDiffSentinelRows {
		width, op, operands, mode, wantLeg, wantDnKey, wantDnFlags := decnumberDiffParseSentinelRow(t, rowIndex, row)
		x := decnumberDiffMaterialize(t, width, operands[0].lo, operands[0].hi)
		y, z := x, x
		if op.arity >= 2 {
			y = decnumberDiffMaterialize(t, width, operands[1].lo, operands[1].hi)
		}
		if op.arity >= 3 {
			z = decnumberDiffMaterialize(t, width, operands[2].lo, operands[2].hi)
		}
		native, port, dn := decnumberDiffLegs(t, width, op, x, y, z, mode)
		if native != wantLeg {
			t.Fatalf("sentinel row %d (%s): Intel C leg %q diverges from pinned %q", rowIndex, row, native, wantLeg)
		}
		if port != wantLeg {
			t.Fatalf("sentinel row %d (%s): Go port leg %q diverges from pinned %q", rowIndex, row, port, wantLeg)
		}
		if dn.rc != 0 {
			t.Fatalf("sentinel row %d (%s): decNumber leg hard failure rc=%d parse_status=%08x", rowIndex, row, dn.rc, dn.parseStatus)
		}
		dnFlags5, unknown := decnumberDiffProjectStatus(dn.rawStatus)
		if unknown != 0 {
			t.Fatalf("sentinel row %d (%s): decNumber leg unknown status bits %08x", rowIndex, row, unknown)
		}
		if got := dn.triple.key(); got != wantDnKey || dnFlags5 != wantDnFlags {
			t.Fatalf("sentinel row %d (%s): decNumber leg %s/%02x diverges from pinned %s/%02x (raw status %08x)",
				rowIndex, row, got, dnFlags5, wantDnKey, wantDnFlags, dn.rawStatus)
		}
		executed++
	}
	if uint64(executed) != decnumberDiffSentinelRowCount {
		t.Fatalf("executed %d sentinel rows, want %d", executed, decnumberDiffSentinelRowCount)
	}
	t.Logf("decNumber differential routing sentinels: %d/%d", executed, executed)
}

// decnumberDiffParseSentinelRow parses one pinned row:
//
//	d<width> <op> x=<bits> [y=<bits>] [z=<bits>] m=<mode> -> <bits>/<flags> dn=<triple>/<flags5>
func decnumberDiffParseSentinelRow(t *testing.T, rowIndex int, row string) (width decnumberDiffWidthParams, op decnumberDiffOp, operands [3]decnumberDiff128Words, mode int, wantLeg, wantDnKey string, wantDnFlags uint32) {
	t.Helper()
	fields := strings.Fields(row)
	fail := func(reason string) {
		t.Fatalf("sentinel row %d is malformed (%s): %q", rowIndex, reason, row)
	}
	if len(fields) < 6 {
		fail("field count")
	}
	switch fields[0] {
	case "d32":
		width = decnumberDiffWidth32
	case "d64":
		width = decnumberDiffWidth64
	case "d128":
		width = decnumberDiffWidth128
	default:
		fail("width tag")
	}
	found := false
	for _, candidate := range decnumberDiffRoundedOpsTable {
		if candidate.name == fields[1] {
			op, found = candidate, true
		}
	}
	if fields[1] == decnumberDiffFmaOp.name {
		op, found = decnumberDiffFmaOp, true
	}
	if fields[1] == decnumberDiffSqrtOp.name {
		op, found = decnumberDiffSqrtOp, true
	}
	if !found {
		fail("operation")
	}
	parseBits := func(text string) decnumberDiff128Words {
		if width.bits == 128 {
			hiText, loText, ok := strings.Cut(text, ":")
			if !ok {
				fail("128-bit operand form")
			}
			hi, err := strconv.ParseUint(hiText, 16, 64)
			if err != nil {
				fail("128-bit hi word")
			}
			lo, err := strconv.ParseUint(loText, 16, 64)
			if err != nil {
				fail("128-bit lo word")
			}
			return decnumberDiff128Words{lo: lo, hi: hi}
		}
		bits, err := strconv.ParseUint(text, 16, 64)
		if err != nil {
			fail("operand bits")
		}
		return decnumberDiff128Words{lo: bits}
	}
	cursor := 2
	prefixes := [...]string{"x=", "y=", "z="}
	for slot := 0; slot < op.arity; slot++ {
		if cursor >= len(fields) || !strings.HasPrefix(fields[cursor], prefixes[slot]) {
			fail("operand slots")
		}
		operands[slot] = parseBits(strings.TrimPrefix(fields[cursor], prefixes[slot]))
		cursor++
	}
	if cursor >= len(fields) || !strings.HasPrefix(fields[cursor], "m=") {
		fail("mode")
	}
	modeValue, err := strconv.Atoi(strings.TrimPrefix(fields[cursor], "m="))
	if err != nil || modeValue < 0 || modeValue > 4 {
		fail("mode value")
	}
	mode = modeValue
	cursor++
	if cursor >= len(fields) || fields[cursor] != "->" {
		fail("arrow")
	}
	cursor++
	if cursor >= len(fields) {
		fail("expected leg")
	}
	wantLeg = fields[cursor]
	cursor++
	if cursor >= len(fields) || !strings.HasPrefix(fields[cursor], "dn=") {
		fail("dn pin")
	}
	dnText := strings.TrimPrefix(fields[cursor], "dn=")
	keyText, flagsText, ok := strings.Cut(dnText, "/")
	if !ok {
		fail("dn pin form")
	}
	flags64, err := strconv.ParseUint(flagsText, 16, 32)
	if err != nil {
		fail("dn flags")
	}
	if cursor != len(fields)-1 {
		fail("trailing fields")
	}
	return width, op, operands, mode, wantLeg, keyText, uint32(flags64)
}

// TestGeneratedDecnumberDifferentialStructured executes the structured
// corpus (boundary/probe crosses, the exact-product overflow class, and the
// boundary sqrt sweep) on all three legs with exact comparison.
func TestGeneratedDecnumberDifferentialStructured(t *testing.T) {
	for _, expect := range decnumberDiffWidthExpectations {
		corpus := decnumberDiffMaterializeCorpus(t, expect.width)
		log := newDecnumberDiffDivergenceLog()
		var executed, excluded, known uint64
		for _, op := range decnumberDiffRoundedOpsTable {
			corpus.visitStructuredPairs(func(x, y decnumberDiffOperand) {
				for _, mode := range decnumberDiffModes {
					decnumberDiffCheckCase(t, log, expect.width, op, x, y, x, mode, &known)
					executed++
				}
			})
		}
		corpus.visitStructuredTriples(func(x, y, z decnumberDiffOperand) {
			if decnumberDiffFmaExcluded(x.triple, y.triple, z.triple) {
				excluded++
				return
			}
			for _, mode := range decnumberDiffModes {
				decnumberDiffCheckCase(t, log, expect.width, decnumberDiffFmaOp, x, y, z, mode, &known)
				executed++
			}
		})
		for _, x := range corpus.boundary {
			decnumberDiffCheckCase(t, log, expect.width, decnumberDiffSqrtOp, x, x, x, 0, &known)
			executed++
		}
		log.flush(t)
		if t.Failed() {
			t.FailNow()
		}
		if executed != expect.structuredComparisons {
			t.Fatalf("decimal%d structured executed %d comparisons, want anchored %d", expect.width.bits, executed, expect.structuredComparisons)
		}
		if excluded != expect.structuredFmaExcluded {
			t.Fatalf("decimal%d structured excluded %d fma triples, want anchored %d", expect.width.bits, excluded, expect.structuredFmaExcluded)
		}
		if known != expect.structuredKnownDivergences {
			t.Fatalf("decimal%d structured saw %d known-divergence evaluations, want anchored %d", expect.width.bits, known, expect.structuredKnownDivergences)
		}
		exact := executed - known
		t.Logf("decimal%d decnumber differential structured exact comparisons: %d/%d", expect.width.bits, exact, exact)
		t.Logf("decimal%d decnumber differential structured excluded fma_zero_inf_qnan_invalid_ieee_optional: %d", expect.width.bits, excluded)
		t.Logf("decimal%d decnumber differential structured known divergences: %d/%d", expect.width.bits, known, known)
	}
}

// TestGeneratedDecnumberDifferentialDeterministicRandom executes the seeded
// random streams (canonical triple space, NaN payload zero) on all three
// legs and asserts the anchored stream hashes over the exact operand bits
// it consumed.
func TestGeneratedDecnumberDifferentialDeterministicRandom(t *testing.T) {
	for _, expect := range decnumberDiffWidthExpectations {
		width := expect.width
		log := newDecnumberDiffDivergenceLog()
		digest := decnumberDiffMix(decnumberDiffHashOffset, uint64(width.bits))
		var streamCases, executed, excluded, known uint64
		materializeRandom := func(seed, caseIndex, lane uint64, partner *decnumberDiffTriple) decnumberDiffOperand {
			triple := decnumberDiffRandomTriple(width, seed, caseIndex, lane, partner)
			lo, hi, ok := decnumberDiffEncode(width, triple)
			if !ok {
				t.Fatalf("decimal%d random triple %s does not encode (stream generator defect)", width.bits, triple.key())
			}
			digest = decnumberDiffMix(digest, lo)
			digest = decnumberDiffMix(digest, hi)
			return decnumberDiffOperand{lo: lo, hi: hi, triple: triple, dnStr: triple.dnOperandString()}
		}
		for _, op := range decnumberDiffRoundedOpsTable {
			seed := width.seedBase ^ decnumberDiffOpSeedTag(op.name)
			for caseIndex := uint64(0); caseIndex < decnumberDiffRandomPairsPerOp; caseIndex++ {
				x := materializeRandom(seed, caseIndex, 0, nil)
				y := materializeRandom(seed, caseIndex, 1, &x.triple)
				streamCases++
				for _, mode := range decnumberDiffModes {
					decnumberDiffCheckCase(t, log, width, op, x, y, x, mode, &known)
					executed++
				}
			}
		}
		fmaSeed := width.seedBase ^ decnumberDiffOpSeedTag("fma")
		for caseIndex := uint64(0); caseIndex < decnumberDiffRandomPairsPerOp; caseIndex++ {
			x := materializeRandom(fmaSeed, caseIndex, 0, nil)
			y := materializeRandom(fmaSeed, caseIndex, 1, &x.triple)
			z := materializeRandom(fmaSeed, caseIndex, 2, &x.triple)
			streamCases++
			if decnumberDiffFmaExcluded(x.triple, y.triple, z.triple) {
				excluded++
				continue
			}
			for _, mode := range decnumberDiffModes {
				decnumberDiffCheckCase(t, log, width, decnumberDiffFmaOp, x, y, z, mode, &known)
				executed++
			}
		}
		sqrtSeed := width.seedBase ^ decnumberDiffOpSeedTag("sqrt")
		for caseIndex := uint64(0); caseIndex < decnumberDiffRandomPairsPerOp; caseIndex++ {
			x := materializeRandom(sqrtSeed, caseIndex, 0, nil)
			streamCases++
			decnumberDiffCheckCase(t, log, width, decnumberDiffSqrtOp, x, x, x, 0, &known)
			executed++
		}
		digest = decnumberDiffMix(digest, streamCases)
		log.flush(t)
		if t.Failed() {
			t.FailNow()
		}
		if digest != expect.randomStreamHash {
			t.Fatalf("decimal%d random stream hash %d diverges from anchored constant %d", width.bits, digest, expect.randomStreamHash)
		}
		if executed != expect.randomComparisons {
			t.Fatalf("decimal%d random executed %d comparisons, want anchored %d", width.bits, executed, expect.randomComparisons)
		}
		if excluded != expect.randomFmaExcluded {
			t.Fatalf("decimal%d random excluded %d fma triples, want anchored %d", width.bits, excluded, expect.randomFmaExcluded)
		}
		if known != expect.randomKnownDivergences {
			t.Fatalf("decimal%d random saw %d known-divergence evaluations, want anchored %d", width.bits, known, expect.randomKnownDivergences)
		}
		exact := executed - known
		t.Logf("decimal%d decnumber differential random exact comparisons: %d/%d", width.bits, exact, exact)
		t.Logf("decimal%d decnumber differential random excluded fma_zero_inf_qnan_invalid_ieee_optional: %d", width.bits, excluded)
		t.Logf("decimal%d decnumber differential random known divergences: %d/%d", width.bits, known, known)
	}
}

// decnumberDiffOpSeedTag mirrors the devtools codegen's per-operation seed
// tags (the anchored stream hashes pin the pairing).
func decnumberDiffOpSeedTag(name string) uint64 {
	switch name {
	case "add":
		return 0xa1
	case "sub":
		return 0xa2
	case "mul":
		return 0xa3
	case "div":
		return 0xa4
	case "quantize":
		return 0xa5
	case "fma":
		return 0xa6
	case "sqrt":
		return 0xa7
	default:
		panic("unknown decnumber differential operation seed tag")
	}
}
