
//go:build cgo && bid754_native && bid754_decnumber_diff

package bid754

// decNumber third-oracle differential gate runner.
//
// Three legs per case: pinned Intel BID C (the existing generated FFI shim
// surface), the Go mechanical port (asserted bit- and flag-exact against
// Intel inside the same shim helpers), and pinned IBM decNumber 3.68
// evaluated structurally in a width-fixed GDA context. Comparison is exact
// over the (class, sign, coefficient, exponent) triple — cohort-exact for
// finite values — plus the projected IEEE 5-flag word. There is no
// tolerance, no runtime heuristic, and no runtime skip: the only cases not
// compared are the generation-time exclusion classes this runner replays
// and counts against the anchored totals. A divergence is a finding, never
// noise: it fails the gate with the full case identity and is resolved
// through the documented four-way procedure.
//
// Always full-scale: no shard variables, no reduced smoke subset.

import (
	"encoding/binary"
	"encoding/hex"
	"fmt"
	"math/big"
	"strconv"
	"strings"
	"testing"
)

