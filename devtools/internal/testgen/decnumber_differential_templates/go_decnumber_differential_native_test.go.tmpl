// decnumberDiffKnownDivergenceRow is one hand-audited real divergence
// pinned in the manifest (testgen_manifest.json decnumber_differential
// known_divergences, classified through the documented four-way procedure).
// The runner still executes the case on every leg and requires both sides
// to reproduce the pinned divergent results exactly — a change on either
// side fails the gate for re-audit — and counts the evaluation as a known
// divergence instead of an exact comparison.
type decnumberDiffKnownDivergenceRow struct {
	op                     string
	mode                   int
	xLo, xHi, yLo, yHi     uint64
	zLo, zHi               uint64
	intelLeg               string
	dnKey                  string
	dnFlags5               uint32
	reason                 string
}

var decnumberDiffKnownDivergences32 = []decnumberDiffKnownDivergenceRow{
@@DND_KNOWN_DIVERGENCE_ROWS32@@}

var decnumberDiffKnownDivergences64 = []decnumberDiffKnownDivergenceRow{
@@DND_KNOWN_DIVERGENCE_ROWS64@@}

var decnumberDiffKnownDivergences128 = []decnumberDiffKnownDivergenceRow{
@@DND_KNOWN_DIVERGENCE_ROWS128@@}

func decnumberDiffKnownDivergencesFor(width decnumberDiffWidthParams) []decnumberDiffKnownDivergenceRow {
	switch width.bits {
	case 32:
		return decnumberDiffKnownDivergences32
	case 64:
		return decnumberDiffKnownDivergences64
	default:
		return decnumberDiffKnownDivergences128
	}
}

// decnumberDiffModes is the fixed native Intel rounding-mode execution
