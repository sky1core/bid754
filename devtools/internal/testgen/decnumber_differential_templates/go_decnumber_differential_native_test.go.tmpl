// decnumberDiffOperand is one materialized corpus operand: raw bits, the
// independently decoded triple, and the exact decNumber transfer string
// (built once, reused across every op/mode combination).
type decnumberDiffOperand struct {
	lo, hi uint64
	triple decnumberDiffTriple
	dnStr  string
}

func decnumberDiffMaterialize(t *testing.T, width decnumberDiffWidthParams, lo, hi uint64) decnumberDiffOperand {
	t.Helper()
	triple, canonical := decnumberDiffDecodeCanonical(width, lo, hi)
	if !canonical {
		t.Fatalf("decimal%d decnumber differential corpus operand %s is non-canonical (corpus contract violation)",
			width.bits, decnumberDiffBitsText(width, lo, hi))
	}
	return decnumberDiffOperand{lo: lo, hi: hi, triple: triple, dnStr: triple.dnOperandString()}
}

type decnumberDiffCorpus struct {
	width         decnumberDiffWidthParams
	boundary      []decnumberDiffOperand
	probes        []decnumberDiffOperand
	exactProduct  []decnumberDiffOperand
	exactProductZ []decnumberDiffOperand
}

func decnumberDiffMaterializeCorpus(t *testing.T, width decnumberDiffWidthParams) decnumberDiffCorpus {
	t.Helper()
	corpus := decnumberDiffCorpus{width: width}
	materializeAll := func(loHi func(i int) (uint64, uint64), n int) []decnumberDiffOperand {
		out := make([]decnumberDiffOperand, 0, n)
		for i := 0; i < n; i++ {
			lo, hi := loHi(i)
			out = append(out, decnumberDiffMaterialize(t, width, lo, hi))
		}
		return out
	}
	switch width.bits {
	case 32:
		corpus.boundary = materializeAll(func(i int) (uint64, uint64) { return uint64(decnumberDiffBoundary32Values[i]), 0 }, len(decnumberDiffBoundary32Values))
		corpus.probes = materializeAll(func(i int) (uint64, uint64) { return uint64(decnumberDiffProbes32Values[i]), 0 }, len(decnumberDiffProbes32Values))
		corpus.exactProduct = materializeAll(func(i int) (uint64, uint64) { return uint64(decnumberDiffExactProduct32Values[i]), 0 }, len(decnumberDiffExactProduct32Values))
		corpus.exactProductZ = materializeAll(func(i int) (uint64, uint64) { return uint64(decnumberDiffExactProductZ32Values[i]), 0 }, len(decnumberDiffExactProductZ32Values))
	case 64:
		corpus.boundary = materializeAll(func(i int) (uint64, uint64) { return decnumberDiffBoundary64Values[i], 0 }, len(decnumberDiffBoundary64Values))
		corpus.probes = materializeAll(func(i int) (uint64, uint64) { return decnumberDiffProbes64Values[i], 0 }, len(decnumberDiffProbes64Values))
		corpus.exactProduct = materializeAll(func(i int) (uint64, uint64) { return decnumberDiffExactProduct64Values[i], 0 }, len(decnumberDiffExactProduct64Values))
		corpus.exactProductZ = materializeAll(func(i int) (uint64, uint64) { return decnumberDiffExactProductZ64Values[i], 0 }, len(decnumberDiffExactProductZ64Values))
	default:
		corpus.boundary = materializeAll(func(i int) (uint64, uint64) {
			return decnumberDiffBoundary128Values[i].lo, decnumberDiffBoundary128Values[i].hi
		}, len(decnumberDiffBoundary128Values))
		corpus.probes = materializeAll(func(i int) (uint64, uint64) {
			return decnumberDiffProbes128Values[i].lo, decnumberDiffProbes128Values[i].hi
		}, len(decnumberDiffProbes128Values))
		corpus.exactProduct = materializeAll(func(i int) (uint64, uint64) {
			return decnumberDiffExactProduct128Values[i].lo, decnumberDiffExactProduct128Values[i].hi
		}, len(decnumberDiffExactProduct128Values))
		corpus.exactProductZ = materializeAll(func(i int) (uint64, uint64) {
			return decnumberDiffExactProductZ128Values[i].lo, decnumberDiffExactProductZ128Values[i].hi
		}, len(decnumberDiffExactProductZ128Values))
	}
	return corpus
}

// decnumberDiffVisitStructuredPairs is the fixed structured pair visitation
// shared by the corpus contract digest and the differential executor:
// boundary x probes in both operand orders, then probes x probes, then the
// exact-product cross. The devtools codegen replicates this order when
// pinning the anchored structured stream hash.
func (c decnumberDiffCorpus) visitStructuredPairs(visit func(x, y decnumberDiffOperand)) {
	for _, x := range c.boundary {
		for _, y := range c.probes {
			visit(x, y)
			visit(y, x)
		}
	}
	for _, x := range c.probes {
		for _, y := range c.probes {
			visit(x, y)
		}
	}
	for _, x := range c.exactProduct {
		for _, y := range c.exactProduct {
			visit(x, y)
		}
	}
}

// visitStructuredTriples: boundary value rotated through all three fma
// slots against (i+j)%len(probes) companion pairs, then probes^3, then
// exact-product x exact-product x addend.
func (c decnumberDiffCorpus) visitStructuredTriples(visit func(x, y, z decnumberDiffOperand)) {
	for i, x := range c.boundary {
		for j, y := range c.probes {
			z := c.probes[(i+j)%len(c.probes)]
			visit(x, y, z)
			visit(y, z, x)
			visit(z, x, y)
		}
	}
	for _, x := range c.probes {
		for _, y := range c.probes {
			for _, z := range c.probes {
				visit(x, y, z)
			}
		}
	}
	for _, x := range c.exactProduct {
		for _, y := range c.exactProduct {
			for _, z := range c.exactProductZ {
				visit(x, y, z)
			}
		}
	}
}

func (c decnumberDiffCorpus) structuredStreamHash() uint64 {
	digest := decnumberDiffMix(decnumberDiffHashOffset, uint64(c.width.bits))
	var visits uint64
	c.visitStructuredPairs(func(x, y decnumberDiffOperand) {
		digest = decnumberDiffMix(digest, x.lo)
		digest = decnumberDiffMix(digest, x.hi)
		digest = decnumberDiffMix(digest, y.lo)
		digest = decnumberDiffMix(digest, y.hi)
		visits++
	})
	c.visitStructuredTriples(func(x, y, z decnumberDiffOperand) {
		digest = decnumberDiffMix(digest, x.lo)
		digest = decnumberDiffMix(digest, x.hi)
		digest = decnumberDiffMix(digest, y.lo)
		digest = decnumberDiffMix(digest, y.hi)
		digest = decnumberDiffMix(digest, z.lo)
		digest = decnumberDiffMix(digest, z.hi)
		visits++
	})
	for _, x := range c.boundary {
		digest = decnumberDiffMix(digest, x.lo)
		digest = decnumberDiffMix(digest, x.hi)
		visits++
	}
	return decnumberDiffMix(digest, visits)
}

// ---- leg evaluation (single fan-out shared by differentials and sentinels) ----

// decnumberDiffDnResult is the decNumber leg in comparison-triple form,
// converted from the cgo shim's raw primitive extraction. rc values 0-4
// come from the C shim; rc 5 marks a structurally impossible finite digit
// count reported by decNumber (hard gate failure either way).
type decnumberDiffDnResult struct {
	triple      decnumberDiffTriple
	rawStatus   uint32
	parseStatus uint32
	rc          int
}

func decnumberDiffRunDn(opCode, widthBits, intelRounding int, s1, s2, s3 string, arity int) decnumberDiffDnResult {
	raw := decnumberDiffRunDnRaw(opCode, widthBits, intelRounding, s1, s2, s3, arity)
	result := decnumberDiffDnResult{rawStatus: raw.rawStatus, parseStatus: raw.parseStatus, rc: raw.rc}
	if raw.rc != 0 {
		return result
	}
	switch raw.kind {
	case 1:
		result.triple = decnumberDiffTriple{kind: decnumberDiffKindInf, sign: raw.sign}
	case 2:
		result.triple = decnumberDiffTriple{kind: decnumberDiffKindQNaN, sign: raw.sign}
	case 3:
		result.triple = decnumberDiffTriple{kind: decnumberDiffKindSNaN, sign: raw.sign}
	default:
		digitCount := int(raw.digits)
		if digitCount < 1 || digitCount > 34 {
			result.rc = 5
			return result
		}
		buf := make([]byte, digitCount)
		for i := 0; i < digitCount; i++ {
			buf[i] = byte('0' + raw.bcd[i])
		}
		coeff, ok := new(big.Int).SetString(string(buf), 10)
		if !ok {
			result.rc = 5
			return result
		}
		result.triple = decnumberDiffTriple{kind: decnumberDiffKindFinite, sign: raw.sign, coeff: coeff, exp: raw.exponent}
	}
	return result
}

func decnumberDiffD128(op decnumberDiffOperand) Decimal128BID {
	var value Decimal128BID
	binary.LittleEndian.PutUint64(value[0:8], op.lo)
	binary.LittleEndian.PutUint64(value[8:16], op.hi)
	return value
}

// decnumberDiffLegs evaluates one case on all three legs. The returned
// native and port strings are the generated FFI shim's "<bits>/<rawflags>"
// forms; the decNumber result is structural. This is the single
// operand/mode/dispatch fan-out shared by the differential executors and
// the routing sentinels, so a slot swap, mode miswire, or width/context
// mislabel in this glue skews the differential legs identically while the
// pinned sentinel rows diverge and fail.
func decnumberDiffLegs(t *testing.T, width decnumberDiffWidthParams, op decnumberDiffOp, x, y, z decnumberDiffOperand, mode int) (native, port string, dn decnumberDiffDnResult) {
	t.Helper()
	function := fmt.Sprintf("bid%d_%s", width.bits, op.name)
	switch width.bits {
	case 32:
		switch op.arity {
		case 1:
			native, port = runGeneratedFFICase32Unary(function, uint32(x.lo), mode)
		case 2:
			native, port = runGeneratedFFICase32Binary(function, uint32(x.lo), uint32(y.lo), mode)
		default:
			native, port = runGeneratedFFICase32Ternary(function, uint32(x.lo), uint32(y.lo), uint32(z.lo), mode)
		}
	case 64:
		switch op.arity {
		case 1:
			native, port = runGeneratedFFICase64Unary(function, x.lo, mode)
		case 2:
			native, port = runGeneratedFFICase64Binary(function, x.lo, y.lo, mode)
		default:
			native, port = runGeneratedFFICase64Ternary(function, x.lo, y.lo, z.lo, mode)
		}
	default:
		switch op.arity {
		case 1:
			native, port = runGeneratedFFICase128Unary(function, decnumberDiffD128(x), mode)
		case 2:
			native, port = runGeneratedFFICase128Binary(function, decnumberDiffD128(x), decnumberDiffD128(y), mode)
		default:
			native, port = runGeneratedFFICase128Ternary(function, decnumberDiffD128(x), decnumberDiffD128(y), decnumberDiffD128(z), mode)
		}
	}
	dn = decnumberDiffRunDn(op.opCode, width.bits, mode, x.dnStr, y.dnStr, z.dnStr, op.arity)
	return native, port, dn
}

// decnumberDiffParseLeg splits one FFI shim "<bits>/<rawflags>" string back
// into raw words (the 128-bit form is the little-endian byte hex image).
func decnumberDiffParseLeg(t *testing.T, width decnumberDiffWidthParams, leg string) (lo, hi uint64, rawFlags uint32) {
	t.Helper()
	bitsText, flagsText, ok := strings.Cut(leg, "/")
	if !ok {
		t.Fatalf("decimal%d decnumber differential: malformed FFI leg %q", width.bits, leg)
	}
	flags64, err := strconv.ParseUint(flagsText, 16, 32)
	if err != nil {
		t.Fatalf("decimal%d decnumber differential: malformed FFI flags %q: %v", width.bits, leg, err)
	}
	switch width.bits {
	case 32, 64:
		bits, err := strconv.ParseUint(bitsText, 16, 64)
		if err != nil {
			t.Fatalf("decimal%d decnumber differential: malformed FFI bits %q: %v", width.bits, leg, err)
		}
		return bits, 0, uint32(flags64)
	default:
		raw, err := hex.DecodeString(bitsText)
		if err != nil || len(raw) != 16 {
			t.Fatalf("decimal128 decnumber differential: malformed FFI bits %q: %v", leg, err)
		}
		return binary.LittleEndian.Uint64(raw[0:8]), binary.LittleEndian.Uint64(raw[8:16]), uint32(flags64)
	}
}

// ---- divergence recording ----

// decnumberDiffDivergenceLog records every divergence of one executor run:
// full identities for the first sample budget, bucket counts for all of
// them. A divergence is a finding to classify through the four-way
// procedure, so the run reports the complete population instead of stopping
// at the first case, then fails.
type decnumberDiffDivergenceLog struct {
	total   uint64
	buckets map[string]uint64
	samples []string
}

const decnumberDiffDivergenceSampleBudget = 25
const decnumberDiffDivergenceAbortThreshold = 5000

func newDecnumberDiffDivergenceLog() *decnumberDiffDivergenceLog {
	return &decnumberDiffDivergenceLog{buckets: map[string]uint64{}}
}

func (l *decnumberDiffDivergenceLog) record(t *testing.T, bucket, detail string) {
	t.Helper()
	l.total++
	l.buckets[bucket]++
	if len(l.samples) < decnumberDiffDivergenceSampleBudget {
		l.samples = append(l.samples, detail)
	}
	if l.total >= decnumberDiffDivergenceAbortThreshold {
		l.flush(t)
		t.Fatalf("decnumber differential: aborting after %d divergences (systemic skew; see bucket counts above)", l.total)
	}
}

func (l *decnumberDiffDivergenceLog) flush(t *testing.T) {
	t.Helper()
	if l.total == 0 {
		return
	}
	for _, sample := range l.samples {
		t.Error(sample)
	}
	for bucket, count := range l.buckets {
		t.Errorf("decnumber differential divergence bucket %s: %d", bucket, count)
	}
	t.Errorf("decnumber differential divergences total: %d (classify each through the documented four-way procedure)", l.total)
}

// ---- one differential comparison ----

// decnumberDiffKnownLookup returns the pinned known-divergence row for one
// case identity, if any.
func decnumberDiffKnownLookup(width decnumberDiffWidthParams, op decnumberDiffOp, x, y, z decnumberDiffOperand, mode int) *decnumberDiffKnownDivergenceRow {
	rows := decnumberDiffKnownDivergencesFor(width)
	for i := range rows {
		row := &rows[i]
		if row.op != op.name || row.mode != mode {
			continue
		}
		if row.xLo != x.lo || row.xHi != x.hi {
			continue
		}
		if op.arity >= 2 && (row.yLo != y.lo || row.yHi != y.hi) {
			continue
		}
		if op.arity >= 3 && (row.zLo != z.lo || row.zHi != z.hi) {
			continue
		}
		return row
	}
	return nil
}

func decnumberDiffCheckCase(t *testing.T, log *decnumberDiffDivergenceLog, width decnumberDiffWidthParams, op decnumberDiffOp, x, y, z decnumberDiffOperand, mode int, knownDivergences *uint64) {
	native, port, dn := decnumberDiffLegs(t, width, op, x, y, z, mode)
	if native != port {
		t.Fatalf("decimal%d %s port!=Intel: x=%s y=%s z=%s mode=%d C=%s port=%s",
			width.bits, op.name, decnumberDiffBitsText(width, x.lo, x.hi), decnumberDiffBitsText(width, y.lo, y.hi),
			decnumberDiffBitsText(width, z.lo, z.hi), mode, native, port)
	}
	if dn.rc != 0 {
		t.Fatalf("decimal%d %s decNumber leg hard failure rc=%d parse_status=%08x: x=%q y=%q z=%q mode=%d",
			width.bits, op.name, dn.rc, dn.parseStatus, x.dnStr, y.dnStr, z.dnStr, mode)
	}
	dnFlags5, unknown := decnumberDiffProjectStatus(dn.rawStatus)
	if unknown != 0 {
		t.Fatalf("decimal%d %s decNumber leg raised status bits outside the fixed projection table: raw=%08x unknown=%08x x=%q y=%q z=%q mode=%d",
			width.bits, op.name, dn.rawStatus, unknown, x.dnStr, y.dnStr, z.dnStr, mode)
	}
	if known := decnumberDiffKnownLookup(width, op, x, y, z, mode); known != nil {
		if native != known.intelLeg {
			t.Fatalf("decimal%d %s known-divergence %s: Intel/port leg %q diverges from the pinned %q (re-audit the pinned row)",
				width.bits, op.name, known.reason, native, known.intelLeg)
		}
		if got := dn.triple.key(); got != known.dnKey || dnFlags5 != known.dnFlags5 {
			t.Fatalf("decimal%d %s known-divergence %s: decNumber leg %s/%02x diverges from the pinned %s/%02x (re-audit the pinned row)",
				width.bits, op.name, known.reason, got, dnFlags5, known.dnKey, known.dnFlags5)
		}
		*knownDivergences++
		return
	}
	lo, hi, rawFlags := decnumberDiffParseLeg(t, width, native)
	intelTriple, canonical := decnumberDiffDecodeCanonical(width, lo, hi)
	if !canonical {
		t.Fatalf("decimal%d %s Intel/port result bits are non-canonical: x=%s y=%s z=%s mode=%d result=%s",
			width.bits, op.name, decnumberDiffBitsText(width, x.lo, x.hi), decnumberDiffBitsText(width, y.lo, y.hi),
			decnumberDiffBitsText(width, z.lo, z.hi), mode, native)
	}
	if intelTriple.kind == decnumberDiffKindSNaN || dn.triple.kind == decnumberDiffKindSNaN {
		t.Fatalf("decimal%d %s produced a signaling NaN result class (arithmetic must quiet): intel=%s dn=%s mode=%d",
			width.bits, op.name, intelTriple.key(), dn.triple.key(), mode)
	}
	intelFlags5 := rawFlags & decnumberDiffFlags5Mask
	if !decnumberDiffCompare(intelTriple, intelFlags5, dn.triple, dnFlags5) {
		bucket := fmt.Sprintf("d%d|%s|m%d", width.bits, op.name, mode)
		log.record(t, bucket, fmt.Sprintf(
			"DIVERGENCE d%d %s mode=%d x=%s(%s) y=%s(%s) z=%s(%s) intel=%s[%s] flags5=%02x dn=%s flags5=%02x dn_raw_status=%08x",
			width.bits, op.name, mode,
			decnumberDiffBitsText(width, x.lo, x.hi), x.dnStr,
			decnumberDiffBitsText(width, y.lo, y.hi), y.dnStr,
			decnumberDiffBitsText(width, z.lo, z.hi), z.dnStr,
			native, intelTriple.key(), intelFlags5, dn.triple.key(), dnFlags5, dn.rawStatus))
	}
}

