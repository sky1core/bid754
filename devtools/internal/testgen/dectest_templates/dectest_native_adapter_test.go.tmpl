//go:build cgo && bid754_native

package bid754

import (
	"errors"
	"fmt"
)

func nativeDecTestInput(tc decTestCase) nativeDecTestRequest {
	return nativeDecTestRequest{Operation: tc.Operation, NormalizedOperation: normalizeDecTestOperation(tc.Operation), Operands: tc.Operands, RoundingMode: tc.RoundingMode, Precision: tc.Precision, MaxExponent: tc.MaxExponent, MinExponent: tc.MinExponent, Clamp: tc.Clamp}
}
func executeDecTestOperation(tc decTestCase, testType string) (decTestExecResult, error) {
	result, err := executeNativeDecTestOperation(nativeDecTestInput(tc), testType)
	if err != nil {
		return decTestExecResult{}, err
	}
	return decTestExecResult{Result: result.Result, Flags: result.Flags, Conditions: statusToDecTestConditions(result.Status)}, nil
}
func executeDecTestReadOperation(tc decTestCase, testType string) (decTestExecResult, error) {
	result, err := executeNativeDecTestReadOperation(nativeDecTestInput(tc), testType)
	if errors.Is(err, errNativeUnsupportedDecTestOperation) {
		return decTestExecResult{}, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
	if err != nil {
		return decTestExecResult{}, err
	}
	return decTestExecResult{Result: result.Result, Flags: result.Flags, Conditions: statusToDecTestConditions(result.Status)}, nil
}

func statusToDecTestConditions(status uint32) decTestConditionSet {
	var conditions decTestConditionSet
	var known uint32
	for _, entry := range []struct {
		status uint32
		condition decTestConditionSet
	}{
		{nativeStatusConditionBits.ConversionSyntax, decTestConversionSyntax},
		{nativeStatusConditionBits.DivisionByZero, decTestDivisionByZero},
		{nativeStatusConditionBits.DivisionImpossible, decTestDivisionImpossible},
		{nativeStatusConditionBits.DivisionUndefined, decTestDivisionUndefined},
		{nativeStatusConditionBits.InsufficientStorage, decTestInsufficientStorage},
		{nativeStatusConditionBits.Inexact, decTestInexact},
		{nativeStatusConditionBits.InvalidOperation, decTestInvalidOperation},
		{nativeStatusConditionBits.Overflow, decTestOverflow},
		{nativeStatusConditionBits.Clamped, decTestClamped},
		{nativeStatusConditionBits.Rounded, decTestRounded},
		{nativeStatusConditionBits.Subnormal, decTestSubnormal},
		{nativeStatusConditionBits.Underflow, decTestUnderflow},
	} {
		known |= entry.status
		if status&entry.status != 0 {
			conditions |= entry.condition
		}
	}
	if status &^ known != 0 {
		conditions |= decTestUnknownCondition
	}
	return conditions
}
