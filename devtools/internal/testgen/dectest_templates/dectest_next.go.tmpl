package bid754

import "fmt"

func executeDecTestNextOperation(tc decTestCase, testType string) (decTestExecResult, error) {
	op := normalizeDecTestOperation(tc.Operation)
	if op != "nextplus" && op != "nextminus" {
		return decTestExecResult{}, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
	if len(tc.Operands) != 1 {
		return decTestExecResult{}, fmt.Errorf("%s requires 1 operand, got %d", tc.Operation, len(tc.Operands))
	}
	if decTestOperandString(tc.Operands[0]) == "#" {
		return decTestExecResult{Result: "NaN", Flags: FlagInvalidOperation}, nil
	}
	rndMode, err := decTestCaseRoundingMode(tc)
	if err != nil {
		return decTestExecResult{}, err
	}

	switch testType {
	case "decimal32":
		a, parseFlags := parseDecTestDecimal32Operand(tc.Operands[0], rndMode)
		result, flags := executeDecimal32NextOperation(op, a)
		flags |= parseFlags
		return decTestExecResult{Result: result.String(), Flags: flags}, nil
	case "decimal64":
		a, parseFlags := parseDecTestDecimal64Operand(tc.Operands[0], rndMode)
		result, flags := executeDecimal64NextOperation(op, a)
		flags |= parseFlags
		return decTestExecResult{Result: result.String(), Flags: flags}, nil
	case "decimal128":
		a, parseFlags := parseDecTestDecimal128Operand(tc.Operands[0], rndMode)
		result, flags := executeDecimal128NextOperation(op, a)
		flags |= parseFlags
		return decTestExecResult{Result: result.String(), Flags: flags}, nil
	default:
		return decTestExecResult{}, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
}

func executeDecimal32NextOperation(op string, a Decimal32BID) (Decimal32BID, ExceptionFlags) {
	if op == "nextplus" {
		return a.NextPlus()
	}
	return a.NextMinus()
}

func executeDecimal64NextOperation(op string, a Decimal64BID) (Decimal64BID, ExceptionFlags) {
	if op == "nextplus" {
		return a.NextPlus()
	}
	return a.NextMinus()
}

func executeDecimal128NextOperation(op string, a Decimal128BID) (Decimal128BID, ExceptionFlags) {
	if op == "nextplus" {
		return a.NextPlus()
	}
	return a.NextMinus()
}
