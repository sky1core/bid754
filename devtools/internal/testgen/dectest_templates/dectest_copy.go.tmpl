package bid754

import (
	"fmt"
	"strings"
)

func executeDecTestCopyOperation(tc decTestCase, testType string) (decTestExecResult, error) {
	op := normalizeDecTestOperation(tc.Operation)
	switch op {
	case "copy", "copyabs", "copynegate":
		if len(tc.Operands) != 1 {
			return decTestExecResult{}, fmt.Errorf("%s requires 1 operand, got %d", tc.Operation, len(tc.Operands))
		}
	case "copysign":
		if len(tc.Operands) != 2 {
			return decTestExecResult{}, fmt.Errorf("%s requires 2 operands, got %d", tc.Operation, len(tc.Operands))
		}
	default:
		return decTestExecResult{}, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
	rndMode, err := decTestCaseRoundingMode(tc)
	if err != nil {
		return decTestExecResult{}, err
	}

	switch testType {
	case "decimal32":
		return executeDecimal32CopyOperation(op, tc.Operands, rndMode)
	case "decimal64":
		return executeDecimal64CopyOperation(op, tc.Operands, rndMode)
	case "decimal128":
		return executeDecimal128CopyOperation(op, tc.Operands, rndMode)
	default:
		return decTestExecResult{}, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
}

func executeDecimal32CopyOperation(op string, operands []string, rndMode int) (decTestExecResult, error) {
	a, flags := parseDecTestDecimal32Operand(operands[0], rndMode)
	switch op {
	case "copy":
		return decTestExecResult{Result: a.Copy().String(), Flags: flags}, nil
	case "copyabs":
		return decTestExecResult{Result: a.Abs().String(), Flags: flags}, nil
	case "copynegate":
		return decTestExecResult{Result: a.Negate().String(), Flags: flags}, nil
	case "copysign":
		b, secondFlags := parseDecTestDecimal32Operand(operands[1], rndMode)
		return decTestExecResult{Result: a.CopySign(b).String(), Flags: flags | secondFlags}, nil
	default:
		return decTestExecResult{}, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, op)
	}
}

