func decTestDecimal32Abs(a Decimal32BID) (Decimal32BID, ExceptionFlags) {
	bits := a.ToUint32()
	if bits&bid32NaNMask == bid32NaNMask {
		if bits&bid32SignalingMask == bid32SignalingMask {
			return Decimal32BID(bits &^ bid32SignalingBit), FlagInvalidOperation
		}
		return a, 0
	}
	return a.Abs(), 0
}

func decTestDecimal64Abs(a Decimal64BID) (Decimal64BID, ExceptionFlags) {
	bits := a.ToUint64()
	if bits&bid64NaNMask == bid64NaNMask {
		if bits&bid64SignalingMask == bid64SignalingMask {
			return Decimal64BID(bits &^ bid64SignalingBit), FlagInvalidOperation
		}
		return a, 0
	}
	return a.Abs(), 0
}

func decTestDecimal128Abs(a Decimal128BID) (Decimal128BID, ExceptionFlags) {
	hi, lo := decimal128BIDWords(a)
	if hi&bid128NaNMaskHigh == bid128NaNMaskHigh {
		if hi&bid128SignalMaskHi == bid128SignalMaskHi {
			return decimal128BIDFromWords(hi&^bid128SignalBitHigh, lo), FlagInvalidOperation
		}
		return a, 0
	}
	return a.Abs(), 0
}
