	switch rndMode {
	case bidgoRoundingNearestEven:
		result, flags := decimal32BIDRoundIntegralNearestEvenPort(d)
		return result, flags, nil
	case bidgoRoundingNearestAway:
		result, flags := decimal32BIDRoundIntegralNearestAwayPort(d)
		return result, flags, nil
	case bidgoRoundingTowardZero:
		result, flags := decimal32BIDRoundIntegralZeroPort(d)
