package bid754

import (
	"fmt"
	"strconv"
	"strings"
)

// This file is the portable Go mechanical-port decTest cross-check dispatcher and
// executors (TestGeneratedDectestSuitesGoPort). Unlike the native decNumber-oracle
// executor, every oracle-dispatched operation here runs through the Go BID
// mechanical port (the decimal{32,64,128}BID*Port* wrappers over internal/bidgo),
// so the portable CI legs exercise the product port against the IBM decTest
// expected values. Phase 2 asserts three things per executed case: the exact
// value, the exact quantum (cohort member: sign, integer coefficient, and
// exponent all equal, so notation differences pass but quantum differences
// fail), and IEEE exception-flag parity on the BID five-flag surface
// (invalid/division-by-zero/overflow/underflow/inexact — the flags the port's
// bidgoExceptionFlags mapping can raise). The expected decTest Conditions are
// projected onto that same five-flag surface through the shared
// parseDecTestFlags mapping (which already folds divisionundefined/
// divisionimpossible/conversionsyntax into invalid), so decNumber-only status
// classes (rounded, clamped, subnormal) are structurally outside the compared
// surface rather than ad-hoc-adjusted. The case flags are the accumulation of
// the operand-parse flags and the operation flags, matching decNumber's
// decTest semantics where Conditions cover the whole case.
//
// Operands are parsed through the port from_string at the case rounding mode
// (parseDecimal{32,64,128}BIDPortMode), matching decNumber's decimal*FromString,
// which rounds the operand to the format precision at the context rounding and maps
// malformed input to a NaN rather than an error. This is deliberately the
// non-rejecting port parse, not the public NewDecimal*BIDDirect constructor, whose
// documented job is to reject malformed/unrepresentable public input.

// isGoportDectestRunnerSuite reports whether a suite test type is a fixed-width BID
// suite that the portable Go-port leg iterates. General is excluded whole-suite: its
// arbitrary-precision GDA context does not map onto the fixed-width BID port.
func isGoportDectestRunnerSuite(testType string) bool {
	switch testType {
	case "decimal32", "decimal64", "decimal128":
		return true
	default:
		return false
	}
}

// dectestGoportSkipReason is the runtime mirror of the generator-side
// generatedDectestGoportSkipReason. It classifies every fixed-width-suite case into
// either an executed oracle-op case or one mechanical skip bucket, so the leg stays a
// closed accounting (executed = cases - sum(skip_reasons)). It must stay in lockstep
// with the generator function so the live recount matches the pinned verification.
func dectestGoportSkipReason(ignoredOperations []string, tc decTestCase) (string, bool) {
	op := normalizeDecTestOperation(tc.Operation)
	if shouldSkipDectestIgnoredOperation(ignoredOperations, tc.Operation) {
		return "ignored_operation_" + op, true
	}
	if !dectestGoportOracleOperation(op) {
		return "adapter_operation_out_of_leg", true
	}
	if usesTaggedDecTestLiteral(tc) {
		return "tagged_literal", true
	}
	if hasDecTestFlag(tc.Flags, "conversionsyntax") {
		return "conversion_syntax_divergence", true
	}
	if _, ok := decTestBIDRoundingMode(tc.RoundingMode); !ok {
		return "unsupported_rounding", true
	}
	if dectestGoportNaNPrecedenceOp(op) && dectestGoportNaNPayloadPrecedence(tc) {
		return "binary_op_nan_payload_precedence", true
	}
	if (op == "compare" || op == "comparesig") && dectestGoportCompareHasNaNOperand(tc) {
		return "compare_nan_operand", true
	}
	return "", false
}

func dectestGoportOracleOperation(op string) bool {
	switch op {
	case "add", "subtract", "multiply", "divide", "quantize",
		"compare", "comparesig", "tosci", "toeng", "tointegral", "tointegralx":
		return true
	default:
		return false
	}
}

func dectestGoportNaNPrecedenceOp(op string) bool {
	switch op {
	case "add", "subtract", "multiply", "divide", "quantize":
		return true
	default:
		return false
	}
}

// dectestGoportNaNPayloadPrecedence reports binary-op cases where a quiet-NaN left
// operand meets a signaling-NaN right operand. decNumber (GDA) propagates the
// signaling NaN first while the Intel BID port propagates operands positionally and
// returns the left quiet NaN, so the two libraries pick different NaN identities. This
// mirrors the documented remainder/fma NaN-payload precedence skip.
func dectestGoportNaNPayloadPrecedence(tc decTestCase) bool {
	if len(tc.Operands) != 2 {
		return false
	}
	if !isQuietDecTestNaN(tc.Operands[0]) || !isSignalingDecTestNaN(tc.Operands[1]) {
		return false
	}
	// Skip only genuine divergences: decNumber returns the quietized right sNaN
	// while the port returns the left qNaN, so same-sign, same-payload pairs still
	// agree and must execute (mirrors the precise fma NaN-precedence check).
	left := parseDecTestNaNOperand(tc.Operands[0])
	right := parseDecTestNaNOperand(tc.Operands[1])
	return left.sign != right.sign || left.payload != right.payload
}

func dectestGoportCompareHasNaNOperand(tc decTestCase) bool {
	for _, operand := range tc.Operands {
		if isQuietDecTestNaN(operand) || isSignalingDecTestNaN(operand) {
			return true
		}
	}
	return false
}

// dectestGoportBIDFlagMask is the compared exception surface: the five IEEE 754
// exception flags the BID port raises (bidgoExceptionFlags maps exactly these).
// decNumber-only status classes (Rounded, Clamped, Subnormal) fall outside the
// mask on both sides, so the projection — not a per-case adjustment — is what
// absorbs them.
const dectestGoportBIDFlagMask = FlagInexact | FlagUnderflow | FlagOverflow | FlagDivisionByZero | FlagInvalidOperation

// dectestGoportExpectedFlags projects the case's decTest Conditions onto the BID
// five-flag surface, through the same parseDecTestFlags mapping the native leg
// uses (divisionundefined/divisionimpossible/conversionsyntax fold into invalid
// there). It returns ok=false on an unrecognized condition token, which the
// runner reports as a harness failure rather than skipping silently.
func dectestGoportExpectedFlags(tc decTestCase) (ExceptionFlags, bool) {
	parsed, ok := parseDecTestFlags(tc.Flags)
	if !ok {
		return 0, false
	}
	return parsed & dectestGoportBIDFlagMask, true
}

// dectestGoportFlagExemptReason classifies executed cases whose expected flags
// are NOT compared (value and quantum still are), each a documented
// decNumber-vs-Intel-BID semantic divergence, never a port defect class. It
// must stay in lockstep with the generator-side
// generatedDectestGoportFlagExemptReason so the live recount matches the
// pinned verification.
//
//   - from_string_zero_low_clamp_divergence: a string-conversion (tosci/toeng)
//     case whose zero operand carries an exponent below the format minimum,
//     clamped upward on parse (e.g. toSci 0e-10000 -> 0E-398 Clamped).
//     decNumber raises only Clamped (projecting to None on the five-flag
//     surface) while the Intel BID from_string path the port mechanically
//     reproduces raises Inexact|Underflow for the same low clamp (measured:
//     the port raised exactly Inexact|Underflow on every case in this class,
//     and the readtest string domain pins from_string against Intel
//     bit-for-bit). The class is deliberately this narrow: the measured
//     complement — high-side zero clamps (toSci 0e+10000 -> 0E+369 Clamped)
//     and every arithmetic-result zero clamp (divide 0E-390 1000E+13 ->
//     0E-398 Clamped, multiply 0E-260 1000E-260 -> 0E-398 Clamped, and the
//     finite/Inf divide family) — matched decNumber exactly (both sides
//     quiet on the five-flag surface), so those stay flag-compared. Keyed
//     statically off a tosci/toeng op, clamped-only Conditions (nothing
//     projecting onto the five-flag surface), and a zero expected result
//     with a negative exponent (the low-side clamp).
//
// Exemption never skips condition-token validation: this classifier itself
// accepts only the registered Clamped-only shape, and the runner also parses
// and validates the expected Conditions before consulting it for every case
// that reaches execution.
func dectestGoportFlagExemptReason(tc decTestCase) (string, bool) {
	op := normalizeDecTestOperation(tc.Operation)
	if op != "tosci" && op != "toeng" {
		return "", false
	}
	if !dectestGoportHasOnlyClampedCondition(tc.Flags) {
		return "", false
	}
	if q, ok := dectestGoportQuantumParse(tc.Result); ok && q.coeff == "0" && q.exponent < 0 {
		return "from_string_zero_low_clamp_divergence", true
	}
	return "", false
}

func dectestGoportHasOnlyClampedCondition(flags []string) bool {
	clamped := false
	for _, flag := range flags {
		switch normalizeDecTestFlag(flag) {
		case "", "none", "noflags":
			continue
		case "clamped":
			clamped = true
		default:
			return false
		}
	}
	return clamped
}

// dectestGoportQuantum is one cohort member: sign, integer coefficient (leading
// zeros stripped, "0" for zero), and exponent. Two decTest result strings name
// the same cohort member exactly when all three are equal; notation differences
// ("1.100E+0" vs "11.00E-1") normalize to the same member, while quantum
// differences ("1.1E+0" vs "1.100E+0", or "0" vs "0E-2") do not.
type dectestGoportQuantum struct {
	sign     int
	coeff    string
	exponent int
}

// dectestGoportQuantumParse decomposes a finite decTest numeric literal into its
// cohort member. Special values (Inf/NaN) and non-numeric tokens return
// ok=false: their comparison is fully handled by the Phase 1 value comparator,
// which already checks NaN sign/payload and infinity sign.
func dectestGoportQuantumParse(input string) (dectestGoportQuantum, bool) {
	trimmed := strings.TrimSpace(strings.Trim(input, "'\""))
	if trimmed == "" {
		return dectestGoportQuantum{}, false
	}
	sign := 1
	switch trimmed[0] {
	case '+':
		trimmed = trimmed[1:]
	case '-':
		sign = -1
		trimmed = trimmed[1:]
	}
	if trimmed == "" {
		return dectestGoportQuantum{}, false
	}
	lower := strings.ToLower(trimmed)
	if lower == "inf" || lower == "infinity" || strings.Contains(lower, "nan") {
		return dectestGoportQuantum{}, false
	}

	mantissa := trimmed
	exponent := 0
	if idx := strings.IndexAny(trimmed, "Ee"); idx >= 0 {
		mantissa = trimmed[:idx]
		parsedExponent, err := strconv.Atoi(trimmed[idx+1:])
		if err != nil {
			return dectestGoportQuantum{}, false
		}
		exponent = parsedExponent
	}
	if strings.Count(mantissa, ".") > 1 {
		return dectestGoportQuantum{}, false
	}
	if dot := strings.IndexByte(mantissa, '.'); dot >= 0 {
		exponent -= len(mantissa) - dot - 1
		mantissa = mantissa[:dot] + mantissa[dot+1:]
	}
	if mantissa == "" {
		return dectestGoportQuantum{}, false
	}
	for _, r := range mantissa {
		if r < '0' || r > '9' {
			return dectestGoportQuantum{}, false
		}
	}
	mantissa = strings.TrimLeft(mantissa, "0")
	if mantissa == "" {
		mantissa = "0"
	}
	return dectestGoportQuantum{sign: sign, coeff: mantissa, exponent: exponent}, true
}

// dectestGoportQuantumEqual reports whether two result strings name the same
// cohort member. When either side is not a finite numeric literal the check
// passes: NaN/Inf comparison is the Phase 1 value comparator's job, and the
// compare ops' -1/0/1 tokens trivially agree with themselves. A negative zero
// keeps sign = -1 here, so -0E+2 and 0E+2 stay distinct, matching decTest.
func dectestGoportQuantumEqual(expected, got string) bool {
	left, leftOK := dectestGoportQuantumParse(expected)
	right, rightOK := dectestGoportQuantumParse(got)
	if !leftOK || !rightOK {
		return true
	}
	return left == right
}

// dectestGoportQuantumComparedOperation reports whether an oracle op's expected
// string can be compared as a cohort member at all. toeng is excluded
// structurally: GDA to-engineering-string appends zeros to the coefficient to
// force a multiple-of-3 exponent (toEng 10e10 renders "100E+9"), so the
// engineering rendering itself does not preserve the cohort member and a
// face-value decomposition of the expected string names a different member
// than the operand carries. Every other oracle op's expected string (sci
// notation, arithmetic results, quantize, tointegral(x), compare tokens) is
// member-preserving and stays quantum-compared.
func dectestGoportQuantumComparedOperation(op string) bool {
	return op != "toeng"
}

// runDectestGoportCase executes one oracle-dispatched decTest case through the Go BID
// mechanical port and returns the port result string plus the accumulated case flags
// (operand-parse flags OR operation flags) for value, quantum, and flag comparison.
// Skip classification runs in dectestGoportSkipReason before this is called, so every
// case reaching here is an executable oracle-op case at a supported rounding mode.
func runDectestGoportCase(tc decTestCase, testType string) (string, ExceptionFlags, error) {
	rndMode, ok := decTestBIDRoundingMode(tc.RoundingMode)
	if !ok {
		return "", 0, fmt.Errorf("%w: %s rounding %q", errUnsupportedDecTestOperation, tc.Operation, tc.RoundingMode)
	}
	switch normalizeDecTestOperation(tc.Operation) {
	case "add", "subtract", "multiply", "divide", "quantize":
		return executeDectestGoportArithmetic(tc, testType, rndMode)
	case "compare", "comparesig":
		return executeDectestGoportCompare(tc, testType, rndMode)
	case "tointegral", "tointegralx":
		return executeDectestGoportToIntegral(tc, testType, rndMode)
	case "tosci", "toeng":
		return executeDectestGoportString(tc, testType, rndMode)
	default:
		return "", 0, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
}

func executeDectestGoportArithmetic(tc decTestCase, testType string, rndMode int) (string, ExceptionFlags, error) {
	if len(tc.Operands) != 2 {
		return "", 0, fmt.Errorf("%s requires 2 operands, got %d", tc.Operation, len(tc.Operands))
	}
	op := normalizeDecTestOperation(tc.Operation)
	switch testType {
	case "decimal32":
		a, aFlags := parseDecimal32BIDPortMode(decTestOperandString(tc.Operands[0]), rndMode)
		b, bFlags := parseDecimal32BIDPortMode(decTestOperandString(tc.Operands[1]), rndMode)
		result, opFlags, err := applyDectestGoportArithmetic32(op, a, b, rndMode)
		if err != nil {
			return "", 0, err
		}
		return result.String(), aFlags | bFlags | opFlags, nil
	case "decimal64":
		a, aFlags := parseDecimal64BIDPortMode(decTestOperandString(tc.Operands[0]), rndMode)
		b, bFlags := parseDecimal64BIDPortMode(decTestOperandString(tc.Operands[1]), rndMode)
		result, opFlags, err := applyDectestGoportArithmetic64(op, a, b, rndMode)
		if err != nil {
			return "", 0, err
		}
		return result.String(), aFlags | bFlags | opFlags, nil
	case "decimal128":
		a, aFlags := parseDecimal128BIDPortMode(decTestOperandString(tc.Operands[0]), rndMode)
		b, bFlags := parseDecimal128BIDPortMode(decTestOperandString(tc.Operands[1]), rndMode)
		result, opFlags, err := applyDectestGoportArithmetic128(op, a, b, rndMode)
		if err != nil {
			return "", 0, err
		}
		return result.String(), aFlags | bFlags | opFlags, nil
	default:
		return "", 0, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
}

func applyDectestGoportArithmetic32(op string, a, b Decimal32BID, rndMode int) (Decimal32BID, ExceptionFlags, error) {
	switch op {
	case "add":
		result, flags := decimal32BIDAddPortModeFlags(a, b, rndMode)
		return result, flags, nil
	case "subtract":
		result, flags := decimal32BIDSubPortModeFlags(a, b, rndMode)
		return result, flags, nil
	case "multiply":
		result, flags := decimal32BIDMulPortModeFlags(a, b, rndMode)
		return result, flags, nil
	case "divide":
		result, flags := decimal32BIDDivPortModeFlags(a, b, rndMode)
		return result, flags, nil
	case "quantize":
		result, flags := decimal32BIDQuantizePortModeFlags(a, b, rndMode)
		return result, flags, nil
	default:
		return 0, 0, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, op)
	}
}

