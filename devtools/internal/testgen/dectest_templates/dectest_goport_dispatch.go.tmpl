// executeDectestGoportCompare routes the ordered -1/0/1 result through the port's
// quiet/signaling comparison predicates, accumulating the operand-parse flags and
// the predicate flags. NaN-operand cases are filtered out by the
// compare_nan_operand skip (the Intel BID boolean compare predicates cannot produce
// the GDA NaN-identity result), leaving finite and infinite operands here, so the
// predicate flags are normally empty; they are still accumulated so a predicate
// that unexpectedly raises one fails flag parity instead of hiding.
func executeDectestGoportCompare(tc decTestCase, testType string, rndMode int) (string, ExceptionFlags, error) {
	if len(tc.Operands) != 2 {
		return "", 0, fmt.Errorf("%s requires 2 operands, got %d", tc.Operation, len(tc.Operands))
	}
	signaling := normalizeDecTestOperation(tc.Operation) == "comparesig"
	switch testType {
	case "decimal32":
		a, aFlags := parseDecimal32BIDPortMode(decTestOperandString(tc.Operands[0]), rndMode)
		b, bFlags := parseDecimal32BIDPortMode(decTestOperandString(tc.Operands[1]), rndMode)
		if decimal32BIDIsNaNPort(a) || decimal32BIDIsNaNPort(b) {
			return "", 0, fmt.Errorf("compare NaN operand reached goport executor; skip-filter divergence")
		}
		var less, greater bool
		var lessFlags, greaterFlags ExceptionFlags
		if signaling {
			less, lessFlags = decimal32BIDSignalingLessPort(a, b)
			greater, greaterFlags = decimal32BIDSignalingGreaterPort(a, b)
		} else {
			less, lessFlags = decimal32BIDQuietLessPort(a, b)
			greater, greaterFlags = decimal32BIDQuietGreaterPort(a, b)
		}
		result, err := dectestGoportCompareResult(less, greater)
		return result, aFlags | bFlags | lessFlags | greaterFlags, err
	case "decimal64":
		a, aFlags := parseDecimal64BIDPortMode(decTestOperandString(tc.Operands[0]), rndMode)
		b, bFlags := parseDecimal64BIDPortMode(decTestOperandString(tc.Operands[1]), rndMode)
		if decimal64BIDIsNaNPort(a) || decimal64BIDIsNaNPort(b) {
			return "", 0, fmt.Errorf("compare NaN operand reached goport executor; skip-filter divergence")
		}
		var less, greater bool
		var lessFlags, greaterFlags ExceptionFlags
		if signaling {
			less, lessFlags = decimal64BIDSignalingLessPort(a, b)
			greater, greaterFlags = decimal64BIDSignalingGreaterPort(a, b)
		} else {
			less, lessFlags = decimal64BIDQuietLessPort(a, b)
			greater, greaterFlags = decimal64BIDQuietGreaterPort(a, b)
		}
		result, err := dectestGoportCompareResult(less, greater)
		return result, aFlags | bFlags | lessFlags | greaterFlags, err
	case "decimal128":
		a, aFlags := parseDecimal128BIDPortMode(decTestOperandString(tc.Operands[0]), rndMode)
		b, bFlags := parseDecimal128BIDPortMode(decTestOperandString(tc.Operands[1]), rndMode)
		if decimal128BIDIsNaNPort(a) || decimal128BIDIsNaNPort(b) {
			return "", 0, fmt.Errorf("compare NaN operand reached goport executor; skip-filter divergence")
		}
		var less, greater bool
		var lessFlags, greaterFlags ExceptionFlags
		if signaling {
			less, lessFlags = decimal128BIDSignalingLessPort(a, b)
			greater, greaterFlags = decimal128BIDSignalingGreaterPort(a, b)
		} else {
			less, lessFlags = decimal128BIDQuietLessPort(a, b)
			greater, greaterFlags = decimal128BIDQuietGreaterPort(a, b)
		}
		result, err := dectestGoportCompareResult(less, greater)
		return result, aFlags | bFlags | lessFlags | greaterFlags, err
	default:
		return "", 0, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
}

func dectestGoportCompareResult(less, greater bool) (string, error) {
	switch {
	case less && greater:
		// Non-NaN operands are mutually exclusive under a correct port; both true
		// signals a broken quiet/signaling predicate, so fail loudly instead of
		// silently returning -1 and masking the defect.
		return "", fmt.Errorf("port compare predicates returned both less and greater")
	case less:
		return "-1", nil
	case greater:
		return "1", nil
	default:
		return "0", nil
	}
}

// executeDectestGoportToIntegral routes tointegral through the port's fixed-mode
// (no-inexact) round-to-integral entrypoints and tointegralx through the exact
// entrypoints (Bid*RoundIntegralExact at the case rounding mode), matching the
// GDA split: round-to-integral-exact raises Inexact, the plain form does not.
// The operand-parse flags accumulate into the case flags either way.
func executeDectestGoportToIntegral(tc decTestCase, testType string, rndMode int) (string, ExceptionFlags, error) {
	if len(tc.Operands) != 1 {
		return "", 0, fmt.Errorf("%s requires 1 operand, got %d", tc.Operation, len(tc.Operands))
	}
	exact := normalizeDecTestOperation(tc.Operation) == "tointegralx"
	operand := decTestOperandString(tc.Operands[0])
	switch testType {
	case "decimal32":
		d, parseFlags := parseDecimal32BIDPortMode(operand, rndMode)
		var result Decimal32BID
		var opFlags ExceptionFlags
		if exact {
			result, opFlags = decimal32BIDRoundIntegralExactPortModeFlags(d, rndMode)
		} else {
			var err error
			result, opFlags, err = roundIntegralDectestGoport32(d, rndMode)
			if err != nil {
				return "", 0, err
			}
		}
		return result.String(), parseFlags | opFlags, nil
	case "decimal64":
		d, parseFlags := parseDecimal64BIDPortMode(operand, rndMode)
		var result Decimal64BID
		var opFlags ExceptionFlags
		if exact {
			result, opFlags = decimal64BIDRoundIntegralExactPortModeFlags(d, rndMode)
		} else {
			var err error
			result, opFlags, err = roundIntegralDectestGoport64(d, rndMode)
			if err != nil {
				return "", 0, err
			}
		}
		return result.String(), parseFlags | opFlags, nil
	case "decimal128":
		d, parseFlags := parseDecimal128BIDPortMode(operand, rndMode)
		var result Decimal128BID
		var opFlags ExceptionFlags
		if exact {
			result, opFlags = decimal128BIDRoundIntegralExactPortModeFlags(d, rndMode)
		} else {
			var err error
			result, opFlags, err = roundIntegralDectestGoport128(d, rndMode)
			if err != nil {
				return "", 0, err
			}
		}
		return result.String(), parseFlags | opFlags, nil
	default:
		return "", 0, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
}

