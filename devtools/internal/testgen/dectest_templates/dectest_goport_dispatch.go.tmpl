// executeDectestGoportString routes tosci/toeng through the port value type's String().
// The rendering raises no flags, so the case flags are exactly the operand-parse
// flags (decTest rounds the operand to the format precision on parse, which is where
// these cases' Inexact conditions come from). The Phase 2 quantum comparison checks
// the exact cohort member of the rendered value; the sci/eng notation difference
// itself is normalized away by the quantum decomposition.
func executeDectestGoportString(tc decTestCase, testType string, rndMode int) (string, ExceptionFlags, error) {
	if len(tc.Operands) != 1 {
		return "", 0, fmt.Errorf("%s requires 1 operand, got %d", tc.Operation, len(tc.Operands))
	}
	operand := decTestOperandString(tc.Operands[0])
	switch testType {
	case "decimal32":
		d, parseFlags := parseDecimal32BIDPortMode(operand, rndMode)
		return d.String(), parseFlags, nil
	case "decimal64":
		d, parseFlags := parseDecimal64BIDPortMode(operand, rndMode)
		return d.String(), parseFlags, nil
	case "decimal128":
		d, parseFlags := parseDecimal128BIDPortMode(operand, rndMode)
		return d.String(), parseFlags, nil
	default:
		return "", 0, fmt.Errorf("%w: %s", errUnsupportedDecTestOperation, tc.Operation)
	}
}
