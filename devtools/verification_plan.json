    {
      "id": "harness-contracts",
      "target": "test-harness",
      "group": "harness",
      "tools": [
        "go",
        "cargo",
        "rustc",
        "python3",
        "bash",
        "git",
        "cc"
      ],
      "prerequisites": [
        "generation-inputs"
