          "(?m)^ok\\s+github.com/sky1core/bid754/devtools/cmd/mutgate\\s",
          "(?m)^ok\\s+github.com/sky1core/bid754/devtools/cmd/explorediff\\s"
        ],
        "passes": [
          "TestExternalConsumer",
          "TestDefaultBuildExcludesGeneratedVerification",
          "TestExternalConsumerBoundary",
          "TestShellSyntaxChecksEverySelectedScript",
          "TestRunnerRejectsNoOpAndDetectsTheIntendedSyntaxDefect",
          "TestAdjudicatorRejectsMissingMixedStaleAndWeakenedEvidence",
          "TestCodecAdjudicationRequiresEachLanguageAndItsAnchoredCounts",
          "TestMatrixRejectsMissingRequiredPlatform",
          "TestSourceSnapshotRoundTrip",
          "TestSourceSnapshotRestoredCorruptions",
          "TestSourceSnapshotArchiveCorruptions",
          "TestSourceSnapshotFrozenReceiver",
          "TestSourceSnapshotShellWrapperIdentity",
          "TestSourceSnapshotUnsafeManifest",
          "TestSourceSnapshotIndexStagesAndReplacements",
          "TestSourceSnapshotUnsafeIndex",
          "TestSourceSnapshotDestinationSafety",
          "TestSourceSnapshotSHA256Index",
          "TestSourceSnapshotVerifySourceAfterBuild",
          "TestSourceSnapshotContainerTreeID",
          "TestRunnerRejectsInheritedTestSelection",
          "TestSourceSnapshotPortableSymlinkMode",
          "TestDefaultProductSourceOwnershipRejectsRenamedGeneratedSupport",
          "TestExactReferenceDependencyBoundary",
          "TestRunStageClassifiesRealTestOutcomes",
          "TestExactVerdictRequiresIntendedEvidence",
          "TestExactCampaignRealBinary",
          "TestExactCLIAndSnapshotKeepPrimaryIndex",
          "TestSnapshotStagedPaths",
          "TestExactVerdictAggregationIsOrderIndependent",
          "TestSelfCheckRequiresItsArithmeticDiagnostic",
          "TestSourceIdentityBindsUntrackedContentAndSnapshot",
          "TestOutputCannotOverwriteReplayOrExistingFile",
          "TestRelayRejectsInvalidTotals",
          "TestPublishRecordsExclusiveAndFlushErrors",
          "TestRunStageRejectsInheritedShardSelection",
          "TestFrozenBuildInputsIgnoreLaterSourceEdits",
          "TestRelayConsoleErrorsPreserveRecordsAndFail",
          "TestBrokenConsolePipePreservesSpool",
          "TestParserResourceEvidenceRequiresEveryLanguageAndCount",
