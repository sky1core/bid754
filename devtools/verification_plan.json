      "comparison": "fault-detection",
      "evidence": {
        "patterns": [
          "(?m)^ok\\s+github.com/sky1core/bid754/devtools/internal/verification\\s",
          "(?m)^ok\\s+github.com/sky1core/bid754/devtools/internal/scriptcheck\\s",
          "(?m)^ok\\s+github.com/sky1core/bid754/devtools/internal/platformdigest\\s",
          "(?m)^ok\\s+github.com/sky1core/bid754/devtools/internal/goboundary\\s",
